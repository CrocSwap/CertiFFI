    (agrees : ArmCert.Translate.Model.ConsumerMapAgrees spec mapping (HeapV2E17.consumerMapOn S pins base.toNat mapping table))
    (room : 10 ≤ budget) (page : base.toNat % 4096 = 0)
    (low716 : (base + trapOffset).toNat < 2 ^ 55)
    (q : Inputs) (np : TrapPath 10 pins q)
    (initial : BaseInv spec config rows mapping S base budget pins table catalogue entry HeapV2Compose.offsetOf 0 entry) (initialV : ValBindT 10 q 0 entry) :
    ((∀ k, k ≤ 10 → (BaseInv spec config rows mapping S base budget pins table catalogue entry (trapOff 10) k (CertiFFI.Prog.Generic.ModelRunView.stateAt real entry k) ∧
        (k < 10 → ValBindT 10 q k (CertiFFI.Prog.Generic.ModelRunView.stateAt real entry k))) ∧
      ArmCert.Premises.TranslationAgreesV1.TranslationAgrees (HeapV2E17.consumerMapOn S pins base.toNat mapping table)
        (CertiFFI.Prog.Generic.ModelRunView.stateAt real entry k)) ∧
    (CertiFFI.Prog.Generic.ModelRunView.stateAt real entry 10).regs._PC = base + trapOffset ∧
    (∀ k, k < 10 → StepEvents.EvShape spec mapping []
      (stateAt real entry k) (stateAt real entry (k + 1)))) ∧
    CT2Heap.FrameAt entry (CertiFFI.Prog.Generic.ModelRunView.stateAt real entry 10) := by
  have VC : ∀ k, k < 10 → ∀ s f, BaseInv spec config rows mapping S base budget pins table catalogue entry (trapOff 10) k s → (k < 10 → ValBindT 10 q k s) →
      HeapV2StepCerts.RegBind.Holds (HeapV2StepCerts.RegBind.upds k) s f → HeapV2StepCerts.ValBind.VEff k s f → ((k + 1) < 10 → ValBindT 10 q (k + 1) f) := (by
      intro k hk s f inv v holds eff hlt
      have hk' : k = 0 ∨ k = 1 ∨ k = 2 ∨ k = 3 ∨ k = 4 ∨ k = 5 ∨ k = 6 ∨ k = 7 ∨ k = 8 := by omega
      rcases hk' with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
      · exact carryT_10_0 np inv.regBind (v (by decide)) holds eff
      · exact carryT_10_1 np inv.regBind (v (by decide)) holds eff
      · exact carryT_10_2 np inv.regBind (v (by decide)) holds eff
      · exact carryT_10_3 np inv.regBind (v (by decide)) holds eff
      · exact carryT_10_4 np inv.regBind (v (by decide)) holds eff
      · exact carryT_10_5 np inv.regBind (v (by decide)) holds eff
      · exact carryT_10_6 np inv.regBind (v (by decide)) holds eff
      · exact carryT_10_7 np inv.regBind (v (by decide)) holds eff
      · exact carryT_10_8 np inv.regBind (v (by decide)) holds eff)
  have DEC_0 : ∀ x, BaseInv spec config rows mapping S base budget pins table catalogue entry (trapOff 10) 0 x → (0 < 10 → ValBindT 10 q 0 x) →
      (Crypto.CruxCbz.cbzC 1#1 0#5 x ↔ false = true) := (fun x inv v => decT_10_0 np inv.regBind (v (by decide)))
  have DEC_1 : ∀ x, BaseInv spec config rows mapping S base budget pins table catalogue entry (trapOff 10) 1 x → (1 < 10 → ValBindT 10 q 1 x) →
      (Crypto.CruxCbz.cbzC 1#1 1#5 x ↔ false = true) := (fun x inv v => decT_10_1 np inv.regBind (v (by decide)))
  have DEC_3 : ∀ x, BaseInv spec config rows mapping S base budget pins table catalogue entry (trapOff 10) 3 x → (3 < 10 → ValBindT 10 q 3 x) →
      (Crypto.BcondCore.bcondC 1#4 x.regs ↔ false = true) := (fun x inv v => decT_10_3 np inv.regBind (v (by decide)))
  have DEC_5 : ∀ x, BaseInv spec config rows mapping S base budget pins table catalogue entry (trapOff 10) 5 x → (5 < 10 → ValBindT 10 q 5 x) →
      (Crypto.BcondCore.bcondC 1#4 x.regs ↔ false = true) := (fun x inv v => decT_10_5 np inv.regBind (v (by decide)))
  have DEC_7 : ∀ x, BaseInv spec config rows mapping S base budget pins table catalogue entry (trapOff 10) 7 x → (7 < 10 → ValBindT 10 q 7 x) →
      (Crypto.BcondCore.bcondC 3#4 x.regs ↔ false = true) := (fun x inv v => decT_10_7 np inv.regBind (v (by decide)))
  have DEC_9 : ∀ x, BaseInv spec config rows mapping S base budget pins table catalogue entry (trapOff 10) 9 x → (9 < 10 → ValBindT 10 q 9 x) →
      (Crypto.BcondCore.bcondC 1#4 x.regs ↔ true = true) := (fun x inv v => decT_10_9 np inv.regBind (v (by decide)))
  have R := trap5_runV real spec config rows mapping base budget pins table S catalogue entry static nodup (fun k x => (k < 10 → ValBindT 10 q k x) ∧ CT2Heap.FrameAt entry x) agrees room page low716
    (fun k hk s f inv v holds eff => ⟨VC k hk s f inv v.1 holds eff, CT2Heap.frame_carry (CT2Heap.upds_nil k (by omega)) holds v.2⟩)
    (fun x inv v => DEC_0 x inv v.1)
    (fun x inv v => DEC_1 x inv v.1)
    (fun x inv v => DEC_3 x inv v.1)
    (fun x inv v => DEC_5 x inv v.1)
    (fun x inv v => DEC_7 x inv v.1)
    (fun x inv v => DEC_9 x inv v.1)
    initial ⟨fun _ => initialV, CT2Heap.frameAt_refl entry⟩
  exact ⟨⟨fun k hk => ⟨⟨(R.1 k hk).1.1, (R.1 k hk).1.2.1⟩, (R.1 k hk).2⟩, R.2.1, R.2.2⟩, (R.1 10 (Nat.le_refl _)).1.2.2⟩
