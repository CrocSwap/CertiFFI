#check "CURRENT_DECL GB10.Manifest.manifestAuthorityRows"
/-- One row per canonical-source literal: (authority key exactly as built, kind). -/
def manifestAuthorityRows : Array (String × String) := manifestAuthorityRowList.toArray

theorem mem_rows {r : String × String} (h : r ∈ manifestAuthorityRowList) : r ∈ manifestAuthorityRows :=
  Array.mem_def.mpr h

theorem row_mem (n : Nat) (hn : n < manifestAuthorityRowList.length) (r : String × String)
    (same : r = manifestAuthorityRowList[n]) : r ∈ manifestAuthorityRowList :=
  same ▸ List.getElem_mem hn

