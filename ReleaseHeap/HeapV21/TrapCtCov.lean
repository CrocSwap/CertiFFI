    (nodup : (spec.logicalRows.map (·.logical)).Nodup)
    (np1 : TrapPath 8 pins (qOf e1))
    (inv02 : DefaultCurrent.CurrentInv spec config rows mapping (shimMap spec mapping base pins)
      scope image loadBase base offS budget 0 catalogue e2)
    (entryRows2 : TagStatusRows e2 (e2.choiceOcc.getD 1354 0) 1)
    (mrsEntry2 : NativeEntryAdapters.MrsDit.Profile e2)
    (isbEntry2 : NativeEntryAdapters.IsbSy.Profile e2)
    (residue2 : RtBl.CallerInv.CallerResidue e2)
    (slotE2 : RtShim.SlotPrem.ShimSlotPresent pins mapping e2)
    (spE2 : e2.regs.SP_EL0 = BitVec.ofNat 64 pins.sp + BitVec.ofInt 64 16)
    (E2 : NativeBodyDeploy.TrapEntryM spec mapping
      (HeapV2E17.consumerMapOn (fun _ => True) pins base.toNat mapping (rowsFootprint spec.imageRows).byte)
      base pins scope offS e2 rows tableRows2)
    (np2 : TrapPath 8 pins (qOf e2)) :
    (PhasedCT.TimingRec ArmCertCTOrdered.OrderedEventV2.record e1 e2
      (stateAt real e1 15) (stateAt real e2 15)) ∧
    (∀ j, j < 15 → ∃ delta : Array Event, (CertiFFI.Prog.Generic.ModelRunView.stateAt real e1 (j + 1)).events =
      (CertiFFI.Prog.Generic.ModelRunView.stateAt real e1 j).events ++ delta ∧ ArmCertCTOrdered.OrderedEventV2.Covered delta) ∧
    (∀ j, j < 15 → ∃ delta : Array Event, (CertiFFI.Prog.Generic.ModelRunView.stateAt real e2 (j + 1)).events =
      (CertiFFI.Prog.Generic.ModelRunView.stateAt real e2 j).events ++ delta ∧ ArmCertCTOrdered.OrderedEventV2.Covered delta) := by
  obtain ⟨pc1, ev1, _⟩ := initial_4 real spec config rows mapping pins scope image loadBase
    base offS budget catalogue e1 room aligned offPre offPost codeSlot inv01 entryRows1 shimStatic
    himage hload mrsEntry1 isbEntry1 residue1 slotE1 spE1 static spAligned tableRows1 E1 nodup np1
  obtain ⟨pc2, ev2, _⟩ := initial_4 real spec config rows mapping pins scope image loadBase
    base offS budget catalogue e2 room aligned offPre offPost codeSlot inv02 entryRows2 shimStatic
    himage hload mrsEntry2 isbEntry2 residue2 slotE2 spE2 static spAligned tableRows2 E2 nodup np2
  refine ⟨?_, CertiFFI.HeapV21.covered_run real spec mapping (records spec pins) 15 e1 ev1
    (CertiFFI.HeapV21.trapRecords_some spec pins),
    CertiFFI.HeapV21.covered_run real spec mapping (records spec pins) 15 e2 ev2
    (CertiFFI.HeapV21.trapRecords_some spec pins)⟩
  refine PhasedCT.phased_records (stateAt real e1) (stateAt real e2) (fun _ _ _ => True)
    15 trivial ((pc1 0 (by decide)).trans (pc2 0 (by decide)).symm) ?_
  intro j hj _
  exact ⟨StepEvents.pair spec mapping (records spec pins j) _ _ _ _ (ev1 j hj) (ev2 j hj)
    ((pc1 j (by omega)).trans (pc2 j (by omega)).symm)
    ((pc1 (j + 1) (by omega)).trans (pc2 (j + 1) (by omega)).symm), trivial⟩

