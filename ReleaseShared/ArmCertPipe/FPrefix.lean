  induction l1 with
  | nil => intro l2 σ n; simp [ArmCertValue.F.compileRun]
  | cons st rest ih =>
    intro l2 σ n
    simp only [List.cons_append, ArmCertValue.F.compileRun]
    cases h : ArmCertValue.F.compile σ n regions st with
    | none => rfl
    | some p =>
      obtain ⟨ds, σ1⟩ := p
      simp only [ih]
      cases h2 : ArmCertValue.F.compileRun regions σ1 (n + ds.length) rest with
      | none => rfl
      | some q =>
        obtain ⟨ds', σf⟩ := q
        simp only [Option.bind_some, Option.map_some, List.length_append, Nat.add_assoc, List.append_assoc]
        cases ArmCertValue.F.compileRun regions σf (n + (ds.length + ds'.length)) l2 <;> rfl


