  w1 : defs[8]? = some (inputWordDef (xs+8))

theorem loaded_inputs (inputs : List (BitVec 64)) (defs : List Def) (n xs : Nat)
    (lengthEq : inputs.length = n) (pos : LoadPositions defs xs) (inside : xs+32 ≤ n) :
    loadedX (fun i => (evalDefs inputs defs).getD i 0) n = inputLimbs inputs xs := by
  subst n
  have third := loaded_input_word inputs defs 0 (xs+16) pos.w2 (by omega)
  simp only [Nat.add_zero] at third
  simp only [loadedX, inputLimbs, third,
    loaded_input_word inputs defs 1 (xs+24) pos.w3 (by omega),
    loaded_input_word inputs defs 7 xs pos.w0 (by omega),
    loaded_input_word inputs defs 8 (xs+8) pos.w1 (by omega)]

