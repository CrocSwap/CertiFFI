private theorem materialized_splice (higher lower : BitVec 64) :
    Op.add.eval [Op.orr.eval [(Op.lsr 63).eval [lower], (Op.lsl 1).eval [higher]], 0#64] =
      splice higher lower := by
  change ((lower >>> 63) ||| (higher <<< 1)) + 0#64 = _
  rw [BitVec.add_zero, splice, BitVec.or_comm]

theorem doubled_values (v : Nat → BitVec 64) (n : Nat) (rows : Equations v n) :
    doubledWords (loadedX v n) = ⟨v (n+19), v (n+17), v (n+12), v (n+6)⟩ := by
  simp only [doubledWords, loadedX, rows.d0,
    rows.d1, rows.or1, rows.low1, rows.high1,
    rows.d2, rows.or2, rows.low2, rows.high2,
    rows.d3, rows.or3, rows.low3, rows.high3, materialized_splice]
  rfl

theorem selected_value (v : Nat → BitVec 64) (n : Nat) (rows : Equations v n) :
    v (n+35) = correctionWord (loadedX v n) := by
  have k : v (n+21) = BitVec.ofNat 64 correction := by
    rw [rows.combine, rows.constant]
    decide
  have andFold : v (n+18) = Op.and.eval [Op.and.eval [v (n+17),v (n+12)],v (n+6)] := by
    rw [rows.and231, rows.and23]
    change (v (n+12) &&& v (n+6)) &&& v (n+17) = (v (n+17) &&& v (n+12)) &&& v (n+6)
    rw [BitVec.and_comm (v (n+12) &&& v (n+6)), BitVec.and_assoc]
  have compare : v (n+28) = coreComparison (doubledWords (loadedX v n)) := by
    rw [rows.compare, andFold, rows.lowCarry, k, doubled_values v n rows]
    rfl
  rw [rows.select, SecpMath.AddSSA.select_ne_ignores_flags, rows.zf, rows.top, compare, k]
  unfold correctionWord selectCorrectionWords
  rw [adc_zero]
  rfl

#check "CURRENT_DECL rows_coreDouble4"
theorem rows_coreDouble4 (v : Nat → BitVec 64) (n : Nat) (rows : Equations v n) :
    resultWords v n = coreDouble4 (loadedX v n) := by
  unfold coreDouble4
  rw [doubled_values v n rows, ← selected_value v n rows]
  simp only [Addition.coreChain4, resultWords, ← rows.r0, ← rows.c0, ← rows.r1,
    ← rows.c1, ← rows.r2, ← rows.c2, ← rows.r3]

#check "CURRENT_DECL table_correct"
theorem table_correct (inputs : List (BitVec 64)) (defs : List Def) (n xs : Nat)
    (lengthEq : inputs.length = n) (pos : RowPositions defs n)
    (loads : LoadPositions defs xs) (inside : xs+32 ≤ n)
    (hx : (inputLimbs inputs xs).value < modulus) :
    (resultWords (fun i => (evalDefs inputs defs).getD i 0) n).value < modulus ∧
    (resultWords (fun i => (evalDefs inputs defs).getD i 0) n).value =
      (2*(inputLimbs inputs xs).value) % modulus := by
  have equations := equations_of_positions inputs defs n lengthEq pos
  have loaded := loaded_inputs inputs defs n xs lengthEq loads inside
  rw [rows_coreDouble4 _ n equations, loaded]
  exact coreDouble4_correct _ hx

