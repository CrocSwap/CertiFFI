theorem outMem_tracked_c00 (tp : BitVec 64) : (outMemLocs_c00).all (fun q => ((finalSym_c00 tp).memB q.1 q.2).isSome) = true := rfl
theorem outReg_tracked_c00 (tp : BitVec 64) : ([] : List Reg).all (fun r => ((finalSym_c00 tp).regs r).isSome) = true := rfl
