theorem int_shift_zero (x : BitVec 64) : (x <<< (0 : Int)) = x := by
  change BitVec.shiftLeft x 0 = x
  exact BitVec.shiftLeft_zero x

theorem full_extract (x : BitVec 64) :
    BitVec.castWidth (m := 64) (Sail.BitVec.extractLsb x (Int.toNatChecked 63) 0) = x := by
  apply BitVec.eq_of_toNat_eq
  simp [BitVec.castWidth, Sail.BitVec.extractLsb, BitVec.extractLsb, Int.toNatChecked]

theorem mask_bits (i : Nat) : Nat.testBit 1 i = decide (i < 1) := by
  rw [show (1 : Nat) = 2 ^ 1 - 1 from rfl, Nat.testBit_two_pow_sub_one]

theorem word_value (x : BitVec 64) :
    (0#64 ||| (0#64 ||| ROR x 63 &&& 18446744073709551615#64) &&& 1#64) = x >>> (63 : Nat) := by
  have hall : (18446744073709551615#64 : BitVec 64) = BitVec.allOnes 64 := rfl
  simp only [BitVec.zero_or, hall, BitVec.and_allOnes]
  change ((x >>> (63 : Nat) ||| x <<< (1 : Nat)) &&& 1#64) = x >>> (63 : Nat)
  apply BitVec.eq_of_getLsbD_eq
  intro i hi
  simp only [BitVec.getLsbD_and, BitVec.getLsbD_or, BitVec.getLsbD_shiftLeft,
    BitVec.getLsbD_ushiftRight, BitVec.getLsbD_ofNat, mask_bits]
  by_cases h : i < 1
  · simp [h, hi]
  · have hidx : 64 ≤ 63 + i := by omega
    simp [h, BitVec.getLsbD_of_ge x _ hidx]

theorem nat_value (x : BitVec 64) :
    ((ROR x 63).toNat &&& 18446744073709551615 &&& 1) = x.toNat / 2 ^ 63 := by
  have h := congrArg BitVec.toNat (word_value x)
  simpa [BitVec.toNat_and, BitVec.toNat_or, BitVec.toNat_ushiftRight, Nat.shiftRight_eq_div_pow] using h

theorem nat_value_mod (x : BitVec 64) :
    ((ROR x 63).toNat &&& 18446744073709551615) % 2 = x.toNat / 2 ^ 63 := by
  simpa only [Nat.and_one_is_mod] using nat_value x


