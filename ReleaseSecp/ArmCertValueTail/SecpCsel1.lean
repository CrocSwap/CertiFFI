         Int.toNatChecked, Sail.Int.toNatChecked, BitVec.extractLsb', BitVec.toNat_ofInt,
         Sail.BitVec.extractLsb, BitVec.extractLsb, BitVec.toNat_add, BitVec.toNat_setWidth,
