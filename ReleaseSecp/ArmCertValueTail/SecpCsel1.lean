theorem int_shift_zero (x : BitVec 64) : (x <<< (0 : Int)) = x := by
  change BitVec.shiftLeft x 0 = x
  exact BitVec.shiftLeft_zero x

def result (s : NativeState) (Rd : BitVec 5) (Rn : BitVec 5) : BitVec 64 := if s.regs.PSTATE.Z = 1#1 then 0#64 else s.regs.gpr[(GPRSummary.key Rn.toNat).val]

