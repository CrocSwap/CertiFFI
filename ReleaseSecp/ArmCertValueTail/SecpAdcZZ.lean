theorem int_shift_zero (x : BitVec 64) : (x <<< (0 : Int)) = x := by
  change BitVec.shiftLeft x 0 = x
  exact BitVec.shiftLeft_zero x

def result (s : NativeState) (Rd : BitVec 5) : BitVec 64 := 0#64 + 0#64 + s.regs.PSTATE.C.setWidth 64

theorem shape (s : NativeState) (Rd : BitVec 5) (rd : Rd.toNat < 31) :
    (NativeEntryBody.SecpAdcZZ.expected s Rd).1.gpr =
      s.regs.gpr.set (GPRSummary.key Rd.toNat).val (result s Rd) (GPRSummary.key Rd.toNat).isLt ∧
    (NativeEntryBody.SecpAdcZZ.expected s Rd).1.SP_EL0 = s.regs.SP_EL0 ∧
    (NativeEntryBody.SecpAdcZZ.expected s Rd).1.PSTATE = s.regs.PSTATE := by
  have hRd : ¬ (Rd.toNat : Int) = 31 := by have := rd; omega
  unfold NativeEntryBody.SecpAdcZZ.expected NativeEntryBody.SecpAdcZZ.effect_native result
  simp only [hRd, ite_true, ite_false, dite_eq_ite, ite_self]
  all_goals and_intros
  all_goals first
    | rfl
    | trivial
    | (congr 1 <;> apply BitVec.eq_of_toNat_eq <;>
       simp [Functions.integer_subrange, Sail.BitVec.zeroExtend, BitVec.castWidth, Sail.get_slice_int,
         Int.toNatChecked, Sail.Int.toNatChecked, BitVec.extractLsb', BitVec.toNat_ofInt,
         Sail.BitVec.extractLsb, BitVec.extractLsb, BitVec.toNat_add, BitVec.toNat_setWidth,
         BitVec.toNat_and, int_shift_zero] <;> omega)

def upd (Rd : BitVec 5) : List (Reg × Option VUpd) := [(.x (rk Rd), some ⟨.add3, [.lit 0#64, .lit 0#64, .flag 2]⟩)]

theorem tailX (real : Type) [Sail.SailReal real] (source : NativeState) (Rd : BitVec 5) (rd : Rd.toNat < 31)
    (noEret : (Sail.BitVec.extractLsb (NativeEntryBodyDispatch.SecpAdcZZ.selected Rd) 31 12 == 879088#20) = false)
    (profile : NativeEntryBodyAdapters.SecpAdcZZ.Profile source) :
    ClassTailXAt real (NativeEntryBodyDispatch.SecpAdcZZ.selected Rd) NativeEntryBodyAdapters.SecpAdcZZ.writes 6
      source (source.regs._PC + 4#64) (upd Rd) none := by
  intro fetched enc0 budget pins input guard quiet it ss
  obtain ⟨sp, a, fin, hook, _, tail, projection, frame, q, p, sys, _, output, mem, ev, gic, _, pc, np⟩ :=
    ArmBridge.CruxGenGuarded.EntryBodySecpAdcZZ.native_tail real source fetched enc0 Rd rd
      profile noEret pins input guard budget quiet it ss
  have post := entry_spec_post fetched sp (budget + 1) quiet hook
  have actualRegs : a.regs = (NativeEntryBody.SecpAdcZZ.expected
      (actionState (NativeEntryBodyDispatch.SecpAdcZZ.selected Rd) sp 6) Rd).1 := congrArg Prod.fst projection
  obtain ⟨hg, hs, hp⟩ := shape (actionState (NativeEntryBodyDispatch.SecpAdcZZ.selected Rd) sp 6) Rd rd
  rw [← actualRegs] at hg hs hp
