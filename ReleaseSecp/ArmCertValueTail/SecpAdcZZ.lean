  have pA := ActionTransport.pstate (w := NativeEntryBodyDispatch.SecpAdcZZ.selected Rd) (K := 6) post.frame
  simp only [result, gA, pA] at hg hp
  refine ⟨sp, a, fin, hook, tail, frame, q, p, sys, mem, gic, pc, np, ev,
    ValueTailE.z_tail quiet hook frame rfl np, ?_⟩
  apply vholds_set1 fetched fin (rk Rd) _ _
  · exact output.gpr.trans hg
  · exact output.sp.trans (hs.trans (ActionTransport.sp0 post.frame))
