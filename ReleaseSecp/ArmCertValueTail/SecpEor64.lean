      s.regs.gpr.set (GPRSummary.key Rd.toNat).val (result s Rd Rn Rm) (GPRSummary.key Rd.toNat).isLt ∧
    (NativeEntryBody.SecpEor64.expected s Rd Rn Rm).1.SP_EL0 = s.regs.SP_EL0 ∧
    (NativeEntryBody.SecpEor64.expected s Rd Rn Rm).1.PSTATE = s.regs.PSTATE := by
  have hRd : ¬ (Rd.toNat : Int) = 31 := by have := rd; omega
  have hRn : ¬ (Rn.toNat : Int) = 31 := by have := rn; omega
  have hRm : ¬ (Rm.toNat : Int) = 31 := by have := rm; omega
