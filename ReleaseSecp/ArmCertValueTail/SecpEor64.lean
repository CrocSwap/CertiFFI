  simp only [hRd, hRn, hRm, ite_true, ite_false, dite_eq_ite, ite_self]
  all_goals and_intros
  all_goals first
    | rfl
    | trivial
    | (congr 1 <;> apply BitVec.eq_of_toNat_eq <;>
       simp [Functions.integer_subrange, Sail.BitVec.zeroExtend, BitVec.castWidth, Sail.get_slice_int,
         Int.toNatChecked, Sail.Int.toNatChecked, BitVec.extractLsb', BitVec.toNat_ofInt,
         Sail.BitVec.extractLsb, BitVec.extractLsb, BitVec.toNat_add, BitVec.toNat_setWidth,
         BitVec.toNat_and, BitVec.toNat_or, BitVec.toNat_xor, BitVec.toNat_not, int_shift_zero] <;> omega)

