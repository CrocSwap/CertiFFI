theorem int_shift_zero (x : BitVec 64) : (x <<< (0 : Int)) = x := by
  change BitVec.shiftLeft x 0 = x
  exact BitVec.shiftLeft_zero x

def result (s : NativeState) (Rd : BitVec 5) (Rn : BitVec 5) (Rm : BitVec 5) : BitVec 64 := s.regs.gpr[(GPRSummary.key Rn.toNat).val] ^^^ s.regs.gpr[(GPRSummary.key Rm.toNat).val]

theorem shape (s : NativeState) (Rd : BitVec 5) (Rn : BitVec 5) (Rm : BitVec 5) (rd : Rd.toNat < 31) (rn : Rn.toNat < 31) (rm : Rm.toNat < 31) :
