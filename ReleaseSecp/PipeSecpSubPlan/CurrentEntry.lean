theorem entryCodeCovers : ScopeCovers (fun o => o ∈ entryCodeOffsets) := by
  intro c hc i hi
  exact List.mem_flatMap.mpr ⟨c, hc, List.mem_map.mpr ⟨i, List.mem_range.mpr hi, rfl⟩⟩

