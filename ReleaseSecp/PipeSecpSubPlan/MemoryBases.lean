theorem memory_base_c09_16 {domain : QueryDomain} (spec : TopologyImageSpec domain) (config : AttributeConfig)
    (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat) (table sc : Nat → Prop)
    (bytes : Array Nat) (base : BitVec 64) (ifunc : Nat → MemReloc.Word) (p : SecpSubPlanE17.Pins)
