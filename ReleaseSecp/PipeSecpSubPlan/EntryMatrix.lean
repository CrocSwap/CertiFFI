-- GENERATED by secp/gen_entry_matrix.py. Fixed-entry direct checks, AUX pending caller admission.
import PipeSecpSubPlan.SelectedConsumer
import TranslateSpan.EntryMatrix
open Sail ArmFull ArmCertWalk ArmCert.Translate.Model ArmCertValue
open TranslateSpan SelectedRepresentatives
set_option autoImplicit false
set_option maxHeartbeats 150000
set_option maxRecDepth 100000
namespace PipeSecpSubPlan
def actualQueries_c05 (inputs : List (BitVec 64)) (base : BitVec 64) : List AccessQuery :=
  queries (QueryDescriptors.data false) (QueryDescriptors.data true) QueryDescriptors.fetch (selectedSites_c05 inputs) (SecpSubPlanE17.codeVAs.map (fun (c : Nat × Nat) => MemReloc.imageAddress base c.1))
def pointQueries_c05 (inputs : List (BitVec 64)) : List AccessQuery :=
  EntryMatrix.points rs_c05 inputs (fun r : Region => decide (r = O))
def allQueries_c05 (inputs : List (BitVec 64)) (base : BitVec 64) : List AccessQuery :=
  (actualQueries_c05 inputs base) ++ (pointQueries_c05 inputs)
def entryAddresses_c05 (inputs : List (BitVec 64)) (base : BitVec 64) : List (BitVec 64) :=
  (allQueries_c05 inputs base).map (fun q : AccessQuery => q.va)
theorem allQueries_bound_c05 (inputs : List (BitVec 64)) (base : BitVec 64) : (allQueries_c05 inputs base).length ≤ 1030 := by
  have bound := query_length (QueryDescriptors.data false) (QueryDescriptors.data true)
    QueryDescriptors.fetch (selectedSites_c05 inputs) (SecpSubPlanE17.codeVAs.map (fun (c : Nat × Nat) => MemReloc.imageAddress base c.1))
  have cap : SecpSubPlanE17.codeVAs.length + 16 * memorySites_c05.length + totalL rs_c05 ≤ 1030 := by decide
  have pointCount : (pointQueries_c05 inputs).length = totalL rs_c05 := EntryMatrix.points_length _ _ _
  simp only [allQueries_c05,List.length_append,pointCount]
  have actualBound : (actualQueries_c05 inputs base).length ≤ SecpSubPlanE17.codeVAs.length + 16 * memorySites_c05.length := by
    simpa only [actualQueries_c05,List.length_map,selectedSites_c05] using bound
  omega
theorem checked_entry_c05
    (inputs : List (BitVec 64)) (base : BitVec 64)
    (spec : TopologyImageSpec (fun q => q.va ∈ entryAddresses_c05 inputs base))
    (config : AttributeConfig) (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat) (table : Nat → Prop)
    (fuel : Nat) (entry : ArmCertWalk.State)
    (checked : CheckedEntry.checkQueries spec config rows mapping 1030 (allQueries_c05 inputs base) fuel entry = true) :
    ClosedMembershipAt spec config rows mapping (selectedConsumer_c05 inputs base mapping table) entry := by
  have prefixChecked := EntryMatrix.checked_prefix checked
  apply CheckedEntry.closed_selected (fun va => va ∈ entryAddresses_c05 inputs base) spec config rows mapping table
    (selectedSites_c05 inputs) (SecpSubPlanE17.codeVAs.map (fun (c : Nat × Nat) => MemReloc.imageAddress base c.1)) 1030 fuel entry ?_ prefixChecked
  intro q member
  exact List.mem_map.mpr ⟨q,List.mem_append_left _ member,rfl⟩
theorem checked_point_c05
    (inputs : List (BitVec 64)) (base : BitVec 64)
    (spec : TopologyImageSpec (fun q => q.va ∈ entryAddresses_c05 inputs base))
    (config : AttributeConfig) (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat)
    (fuel : Nat) (entry : ArmCertWalk.State)
    (checked : CheckedEntry.checkQueries spec config rows mapping 1030 (allQueries_c05 inputs base) fuel entry = true)
    (r : Region) (n j : Nat) (member : (r,n) ∈ rs_c05) (bound : j < n) :
    ∃ data : S1AccessData spec config rows (EntryMatrix.pointQuery rs_c05 inputs (fun r : Region => decide (r = O)) r j),
      CurrentS1AccessAt spec config rows mapping (EntryMatrix.pointQuery rs_c05 inputs (fun r : Region => decide (r = O)) r j) data entry := by
  exact CheckedEntry.member_current checked _ (List.mem_append_right _ (EntryMatrix.point_member _ _ _ r n j member bound))
#print axioms allQueries_bound_c05
#print axioms checked_entry_c05
#print axioms checked_point_c05

