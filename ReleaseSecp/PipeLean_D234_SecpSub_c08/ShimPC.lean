/-! # PipeLean_D234_SecpSub_c08: every PC fetched by the shim run is a shim or body code word (Translate; generated by tools/gen_shimpc.py) -/

namespace PipeLean_D234_SecpSub_c08.ShimPC
open PipeLean_D234_SecpSub_c08

section Entry
variable (real : Type) [Sail.SailReal real]
    (raw : CheckedTopology.Raw) (config : AttributeConfig) (rows : List PermissionRow)
    (mapping : BitVec 64 → Option Nat) (base : BitVec 64)
    (start : Nat) (imm : BitVec 26) (pins : HeapV2E17.Pins) (entry : NativeState) (catalogue : NativeMteTagCheck.ControlCatalogue)
    (gt : CheckedTopology.check raw (Deployment.addresses EntryBinding.plan base entry start imm (BitVec.ofNat 64 pins.sp)) 4 = true)
    (rt : CheckedTopology.check raw (SecpRawDeployment.addresses EntryBinding.plan base entry) 4 = true)
    (info : Initial.Info EntryBinding.plan raw config rows mapping base (referenceImageI SecpArtifact.elf base (fun _ => 0))
      start imm 17 pins (DefaultState.capacity entry + 2) entry catalogue gt rt)

include info

/-- Per-step PCs of the shim run (prologue / body / epilogue), from the run's own invariants. -/
theorem pc_parts :
    (∀ k, k ≤ 6 → (stateAt real entry k).regs._PC = base + Geometry.shimPC start k) ∧
    (∀ j, j ≤ 17 → (stateAt real entry (7 + j)).regs._PC = base + offset EntryBinding.plan j) ∧
    (∀ k, 25 ≤ k → k ≤ 28 → (stateAt real entry k).regs._PC = base + Geometry.shimPC start (k - 18)) := by
  obtain ⟨pre,savedDIT⟩ := Prologue.of_initial real EntryBinding.plan raw config rows mapping base _ start imm 17 pins (DefaultState.capacity entry+2) entry catalogue gt rt info
  obtain ⟨returned,sp31,slot31,ctl31,⟨used,delta,usedBound⟩,dit31⟩ := DitBodyExit.of_pre real raw config rows mapping base start imm pins entry catalogue gt rt info pre
  have aligned := Geometry.whole_aligned start (InitialCheck.rawPC EntryBinding.plan) 17 base (entryGPR entry 30) info.metadata.startAligned info.metadata.bodyAligned
  have offPre' : ∀ j, j ≤ 6 → InitialCheck.runOffset EntryBinding.plan start 17 base entry j = Geometry.shimPC start j := by
    intro j hj; exact Geometry.whole_prefix start (InitialCheck.rawPC EntryBinding.plan) 17 j base (entryGPR entry 30) hj
  have offPost' : ∀ j, 25 ≤ j → j ≤ 28 → InitialCheck.runOffset EntryBinding.plan start 17 base entry j = Geometry.shimPC start (j-18) := by
    intro j lo hi; exact Geometry.whole_epilogue start (InitialCheck.rawPC EntryBinding.plan) 17 j base (entryGPR entry 30) lo hi
  have straight : ∀ j, 25 ≤ j → j ≤ 27 → InitialCheck.runOffset EntryBinding.plan start 17 base entry (j+1) = InitialCheck.runOffset EntryBinding.plan start 17 base entry j + 4#64 := by
    intro j lo hi
    rw [offPost' (j+1) (by omega) (by omega),offPost' j lo (by omega),show j+1-18=(j-18)+1 by omega]
    exact Geometry.shimPC_succ start _
  have slotPerm := Deployment.slot_permitted EntryBinding.plan raw mapping base entry start imm pins info.metadata.slotAligned
  have status31 := DefaultMTE2.rows_after_delta entry (stateAt real entry 25) (DefaultState.capacity entry+2) 1 used info.status delta (by omega)
  have low3 : (stateAt real entry 3).regs.gpr[30].toNat < 2^55 := by
    rw [pre.x30_3]; exact info.metadata.returnLow
  have target3 : (stateAt real entry 3).regs.gpr[30] = base + InitialCheck.runOffset EntryBinding.plan start 17 base entry 29 := by
    rw [pre.x30_3]
    exact Geometry.caller_target start (InitialCheck.rawPC EntryBinding.plan) 17 base (entryGPR entry 30)
  obtain ⟨epiRuns,finalInv,lr,x9,sp,mem,dit,keep,epiControl,⟨epiUsed,epiDelta,epiBound⟩,epiInvs,epiControls,epiWindow,dit34,lr34⟩ :=
    Factory.epilogue real 17 _ config rows mapping pins _ start imm _ _ base info.code.separated
      (InitialCheck.runOffset EntryBinding.plan start 17 base entry) 29 catalogue entry (stateAt real entry 3)
      (by decide) info.metadata.page aligned straight info.metadata.nodup slotPerm info.slots info.metadata.slotAligned returned
      info.metadata.mrs info.metadata.isb ctl31 info.code offPre' offPost' status31 sp31 slot31 low3 target3
  have pinsChecked : DataFrame.checkPins EntryBinding.plan = true := by decide
  have agree := DataTransport.of_pre real 17 _ config rows mapping pins _ start _ _ base base _ 29 _ (DefaultState.capacity entry+2) entry pre EntryBinding.plan pinsChecked
  obtain ⟨rt7,receipt⟩ := DitBodyEntry.of_pre real raw config rows mapping base start imm pins entry catalogue gt rt info pre
  obtain ⟨_,bodyRuns,bodyInv,-⟩ := DitBodyRun.run real raw config rows mapping base (stateAt real entry 7) rt7 receipt
  refine ⟨fun k hk => ?_, fun j hj => ?_, fun k lo hi => ?_⟩
  · rw [(pre.inv k hk).v1.pc, offPre' k hk]
  · have h := (bodyInv j hj).core.v1.pc
    rw [← StateShift.stateAt_add real entry 7 j] at h
    exact h
  · rw [(epiInvs k lo (by omega)).v1.pc, offPost' k lo hi]

end Entry

theorem plan_len : EntryBinding.plan.code.length = 18 := by decide

/-- **Every PC fetched by the certified shim run (k < 29) is base + a word of plan.code ++ shimCode 8136 67108270#26.** -/
theorem fetch_pc (real : Type) [Sail.SailReal real]
    (raw : CheckedTopology.Raw) (config : AttributeConfig) (rows : List PermissionRow)
    (mapping : BitVec 64 → Option Nat) (base : BitVec 64) (pins : HeapV2E17.Pins) (entry : NativeState) (catalogue : NativeMteTagCheck.ControlCatalogue)
    (checked : Shim32Exact.check raw config rows mapping base pins entry catalogue = true) :
    ∀ k, k < 29 → ∃ w ∈ (Deployment.extend EntryBinding.plan 8136 (67108270#26)).code,
      (stateAt real entry k).regs._PC = base + BitVec.ofNat 64 w.1 := by
  obtain ⟨gt,rt,conditions⟩ := InitialCheck.of_check EntryBinding.plan raw config rows mapping base _ 8136 (67108270#26) 17 pins (DefaultState.capacity entry+2) entry catalogue checked
  have info := Initial.of_conditions EntryBinding.plan raw config rows mapping base _ 8136 (67108270#26) 17 pins (DefaultState.capacity entry+2) entry catalogue gt rt conditions
  obtain ⟨hp, hb, he⟩ := pc_parts real raw config rows mapping base 8136 (67108270#26) pins entry catalogue gt rt info
  intro k hk
  by_cases h1 : k ≤ 6
  · refine ⟨(8136 + 4 * k, (Fetches.word (67108270#26) k).toNat),
      List.mem_append_right _ (List.mem_map.mpr ⟨k, List.mem_range.mpr (by omega), rfl⟩), ?_⟩
    rw [hp k h1]; rfl
  · by_cases h2 : k ≤ 24
    · have hl : k - 7 < EntryBinding.plan.code.length := by rw [plan_len]; omega
      refine ⟨EntryBinding.plan.code[k - 7], List.mem_append_left _ (List.getElem_mem hl), ?_⟩
      have h := hb (k - 7) (by omega)
      rw [show 7 + (k - 7) = k by omega] at h
      rw [h]
      simp only [offset, List.getElem?_eq_getElem hl, Option.getD_some]
    · refine ⟨(8136 + 4 * (k - 18), (Fetches.word (67108270#26) (k - 18)).toNat),
        List.mem_append_right _ (List.mem_map.mpr ⟨k - 18, List.mem_range.mpr (by omega), rfl⟩), ?_⟩
      rw [he k (by omega) (by omega)]; rfl

end PipeLean_D234_SecpSub_c08.ShimPC

#print axioms PipeLean_D234_SecpSub_c08.ShimPC.fetch_pc
