def plan_c00 (tp : BitVec 64) : List ArmCertValue.F.Step :=
  ArmCertValue.RegionAlias.plan normalize_c00 (originalPlan_c00 tp)
theorem plan_length_c00 (tp : BitVec 64) : (plan_c00 tp).length = 101 := rfl
def guardSpec_c00 : List (Nat × Reg × ArmCertPipe.Guard) := []
def outMemLocs_c00 : List (Region × Nat) := [(O,0), (O,1), (O,2), (O,3), (O,4), (O,5), (O,6), (O,7), (O,8), (O,9), (O,10), (O,11), (O,12), (O,13), (O,14), (O,15), (O,16), (O,17), (O,18), (O,19), (O,20), (O,21), (O,22), (O,23), (O,24), (O,25), (O,26), (O,27), (O,28), (O,29), (O,30), (O,31)]
def compiled_c00 (tp : BitVec 64) := ArmCertValue.F.compileRun regions_c00 σ0_c00 n0_c00 (plan_c00 tp)
def D_c00 (tp : BitVec 64) : List Def := ((compiled_c00 tp).getD ([],σ0_c00)).1
def finalSym_c00 (tp : BitVec 64) : Sym := ((compiled_c00 tp).getD ([],σ0_c00)).2
theorem compiles_some_c00 (tp : BitVec 64) : (compiled_c00 tp).isSome = true := rfl
theorem compiles_D_c00 (tp : BitVec 64) : compiled_c00 tp = some (D_c00 tp, finalSym_c00 tp) := rfl
theorem outMem_tracked_c00 (tp : BitVec 64) : (outMemLocs_c00).all (fun q => ((finalSym_c00 tp).memB q.1 q.2).isSome) = true := rfl
theorem outReg_tracked_c00 (tp : BitVec 64) : ([] : List Reg).all (fun r => ((finalSym_c00 tp).regs r).isSome) = true := rfl
def guardIds_c00 (tp : BitVec 64) := guardSpec_c00.mapM fun (a,r,g) =>
  (ArmCertValue.F.compileRun regions_c00 σ0_c00 n0_c00 ((plan_c00 tp).take a)).bind fun p => g.ids? p.2 r
theorem guardIds_tracked_c00 (tp : BitVec 64) : (guardIds_c00 tp).isSome = true := rfl
