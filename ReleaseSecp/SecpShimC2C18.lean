def SecpC2_c18 (rho : AdmissibleSourceCompletion) (caller : AdmissibleCaller rho) : Prop :=
  ∃ (sem : ModelSemantics) (o : OracleChoice) (rows : List ArmCert.Translate.Model.PermissionRow) (mapping : BitVec 64 → Option Nat) (base : BitVec 64) (pins : ArmCert.Translate.Model.HeapV2E17.Pins) (entry : ArmBridge.Draft.NativeState),
    AgreesAt (Configuration.ofSource rho caller) entry.regs ∧ SecpResidual_c18 sem o XlateSecp.World.tables rows mapping base pins rho caller entry

theorem secp_c2_reduce_c18 (rho : AdmissibleSourceCompletion) (caller : AdmissibleCaller rho)
    (sem : ModelSemantics) (payloadOf : BitVec 88 → ModelPayload)
    (disabled : ∀ pcount, TimersDisabled (payloadOf pcount).data.timers)
    (o : OracleChoice) (rows : List ArmCert.Translate.Model.PermissionRow) (mapping : BitVec 64 → Option Nat) (base : BitVec 64) (pins : ArmCert.Translate.Model.HeapV2E17.Pins)
    (residual : ∀ pcount : BitVec 88,
      TimersQuiet (makeModelEntry sem rho caller (payloadOf pcount)).regs (PipeLean_D234_SecpMul_c18.EntryBinding.plan.code.length + 11) →
      SecpResidual_c18 sem o XlateSecp.World.tables rows mapping base pins rho caller (makeModelEntry sem rho caller (payloadOf pcount))) :
    SecpC2_c18 rho caller := by
  have timers := model_timersQuiet sem rho caller (payloadOf 0#88) (disabled 0#88) (PipeLean_D234_SecpMul_c18.EntryBinding.plan.code.length + 11)
  exact ⟨sem, o, rows, mapping, base, pins, makeModelEntry sem rho caller (payloadOf 0#88),
    makeModelEntry_agrees sem rho caller (payloadOf 0#88), residual 0#88 timers⟩

