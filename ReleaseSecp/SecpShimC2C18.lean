/-- **Positive C2 for secp c18 at the shim entry**, every admissible completion and caller. -/
theorem secp_c2 (rho : AdmissibleSourceCompletion) (caller : AdmissibleCaller rho) : SecpC2_c18 rho caller :=
  secp_c2_reduce_c18 rho caller worldSemantics (XlateSecp.World.payload XlateSecp.ShimC18.card_shim_c18)
    (fun _ _ _ => by show (0#64 : BitVec 64).getLsbD 0 = false; decide)
    XlateSecp.Raw.oracle XlateSecp.World.permissionRows XlateSecp.World.mapping XlateSecp.World.base XlateSecp.Shim.shimPins
    (fun pcount timers => residual rho caller XlateSecp.Raw.oracle pcount timers)

