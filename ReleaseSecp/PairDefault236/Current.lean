structure At {domain : QueryDomain} (spec : TopologyImageSpec domain)
    (config : AttributeConfig) (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat)
    (m : Consumer) (catalogue : ControlCatalogue) (s : NativeMteTagCheck.State) : Prop where
  closed : ClosedMembershipAt spec config rows mapping m s
  current : CurrentS1At spec config rows s
  mode : HostEL0ModeAt s.regs
  post : PostRegs s.regs
  debug : ExistingE11DebugAt s.regs
  dcache : currentDCache s.regs = true
  raw : RawImageAt spec.imageRows s.mem
  noUpd : ∀ wr a, DataShape wr a →
    NoUpdateRows {spec.params with haft := hostHAFT s.regs} a spec.imageRows = true
  controls : DefaultAt catalogue s

variable {domain : QueryDomain} {spec : TopologyImageSpec domain}
  {config : AttributeConfig} {rows : List PermissionRow} {mapping : BitVec 64 → Option Nat}
  {m : Consumer} {catalogue : ControlCatalogue} {s : NativeMteTagCheck.State}

theorem At.of_current {t : NativeMteTagCheck.State} (h : At spec config rows mapping m catalogue s)
    (regs : t.regs = s.regs) (current : CurrentS1At spec config rows t)
    (raw : RawImageAt spec.imageRows t.mem) : At spec config rows mapping m catalogue t := by
  refine ⟨?_,current,?_,?_,?_,?_,raw,?_,?_⟩
  · intro va acc aligned n permitted
    obtain ⟨q,hva,hacc,hal,hn,member,data,access⟩ := h.closed va acc aligned n permitted
    exact ⟨q,hva,hacc,hal,hn,member,data,access.of_regs regs⟩
  · rw [regs]; exact h.mode
  · rw [regs]; exact h.post
  · rw [regs]; exact h.debug
  · rw [regs]; exact h.dcache
  · rw [regs]; exact h.noUpd
  · exact by
      rcases h.controls with ⟨⟨el,nrw,aa,rme,vhe,ns,e2h,tge⟩,mte,tco,tcf,prep⟩
      refine ⟨⟨?_,?_,?_,?_,?_,?_,?_,?_⟩,?_,?_,?_,?_⟩
      all_goals (try unfold PreparationAt) <;> rw [regs] <;> assumption

theorem At.of_regs_mem {t : NativeMteTagCheck.State} (h : At spec config rows mapping m catalogue s)
    (regs : t.regs = s.regs) (mem : t.mem = s.mem) : At spec config rows mapping m catalogue t :=
  h.of_current regs (current_s1_frame h.current regs mem) (mem ▸ h.raw)

theorem At.frame {t : NativeMteTagCheck.State} (h : At spec config rows mapping m catalogue s) (f : Frame s t) :
    At spec config rows mapping m catalogue t := h.of_regs_mem f.1 f.2.1

theorem packet_frame {r : Access} (packet : WritePacket r s) :
    WritesOnly (fun x => packet.ad.paddress.address.toNat ≤ x ∧
      x < packet.ad.paddress.address.toNat + r.bytes)
      (fun x => s.mem[x]?) (fun x => packet.after.mem[x]?) := by
  intro x outside
  rw [packet.memory]
  simp only [MemM1.MemWriteD1.wfold_get,outside,ite_false]

theorem At.after_write {r : Access} (h : At spec config rows mapping m catalogue s)
    (packet : WritePacket r s)
    (outside : ∀ i < r.bytes,
      ¬ (rowsFootprint spec.imageRows).byte (packet.ad.paddress.address.toNat + i)) :
    At spec config rows mapping m catalogue packet.after := by
  have separated : Separated (rowsFootprint spec.imageRows).byte
      (fun x => packet.ad.paddress.address.toNat ≤ x ∧
        x < packet.ad.paddress.address.toNat + r.bytes) := by
    intro x table ⟨lo,hi⟩
    have absent := outside (x - packet.ad.paddress.address.toNat) (by omega)
    rw [show packet.ad.paddress.address.toNat + (x - packet.ad.paddress.address.toNat) = x by omega] at absent
    exact absent table
  refine h.of_current packet.registers
    (current_s1_program_write h.current _ (packet_frame packet) separated
      ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_ ?_)
    (raw_image_program_write h.raw _ (packet_frame packet) separated)
  all_goals (try intro _) <;> rw [packet.registers]


theorem read_byte (h : At spec config rows mapping m catalogue s)
    (offset : Nat) (a : BitVec 64) (acc : AccessDescriptor) (aligned pair : Bool)
    (shape : DataShape false acc) (hA : AccDR2 acc) (el : acc.el = EL0)
    (permitted : ∀ prepared, DataShape false prepared → m.permitted a prepared aligned (1 : Int))
    (allowed : TagStatusOK s)
    (pa : BitVec 56) (mapped : mapping a = some pa.toNat) (ram : NotMMIO pa)
    (value : BitVec (1 * 8)) (bytes : ∀ i < 1, s.mem[pa.toNat + i]? = some (value.extractLsb' (8 * i) 8)) :
    ∃ packet : ReadPacket ⟨offset,a,1,acc,aligned,pair⟩ s,
      packet.data = value ∧ packet.ad.paddress.address = pa := by
  let Q := fun ad t => ∃ prepared u W,
    prepared = {acc with tagchecked := prepared.tagchecked} ∧
    NativeMteTagCheck.StatusTrace.TraceFrame s u ∧
    AArch64_TranslateAddress a prepared aligned (1 : Int) u = .ok ad t ∧
    ad.fault.statuscode = .Fault_None ∧ ad.paddress.address = pa ∧ NormalWB ad ∧
    t.regs = s.regs ∧ t.mem = s.mem ∧ t.events = s.events ++ W
  obtain ⟨ad,t,after,draws,q,_,run,events,regs,mem,delta,bound⟩ :=
    ReleaseProfile.DefaultRead1.single1_trace a aligned pair (Nat.mod_one _) acc s pa value hA catalogue h.controls el Q
      (by
        intro prepared u same frame
        obtain ⟨ad,t,run,fault,address,wb,_,regs,mem,⟨W,events⟩,post,controls,delta,status,bytes⟩ :=
          TranslateSpan.DefaultMTE2.translation_from_checked_bytes spec config rows mapping m offset a 1
            aligned pair false acc s shape catalogue h.controls permitted h.closed h.current h.mode h.post
            h.debug h.dcache pa mapped h.raw h.noUpd value bytes allowed prepared u same frame
        refine ⟨ad,t,run,fault,address,wb.normal,wb.inner,wb.outer,post,controls,status,bytes,?_⟩
        exact ⟨prepared,u,W,same,frame,run,fault,address,wb,regs,mem,by rw [events,frame.2.2.1]⟩)
      ram
  obtain ⟨prepared,u,W,same,frame,tr,fault,address,wb,trRegs,trMem,trEvents⟩ := q
  exact ⟨{
    data := value, translationInput := u, translated := t, after := after, ad := ad, walkEvents := W
    prepared := prepared, preparedShape := same, choiceFrame := frame, translation := tr
    sizeOK := by change MemM1.MemWriteD1.SizeOK 1; unfold MemM1.MemWriteD1.SizeOK; omega
    ram := by rw [address]; exact ram
    noFault := fault, normalWB := wb, translationRegs := trRegs, translationMem := trMem
    translationEvents := trEvents, draws := draws, choice := delta, drawBound := bound
    run := run, regs := regs, mem := mem, events := by simpa only [address] using events },rfl,address⟩

