    (outside : ∀ j : Fin N, ¬ (rowsFootprint spec.imageRows).byte (pa j).toNat)
    (s : State)
    (profile : AccessProfile) (pins : ProfileAt profile s)
    (notJoin : (s.regs.FeatureImpl[111] &&
      (Align_bits (BitVec.subInt (BitVec.addInt a (N : Int)) 1) 16 == Align_bits a 16)) = false)
    (lowOrder : ((s.regs.FeatureImpl[190] && pair) && high) = false)
    (plain : Plain acc)
    (current : Current.At spec config rows mapping m catalogue s)
    (statusRows : TagStatusRows s (s.choiceOcc.getD 1354 0) N)
    (permit : ∀ prepared, DataShape true prepared → ∀ (j : Fin N) (aligned : Bool),
      m.permitted (BitVec.addInt a (j.val : Int)) prepared aligned (1 : Int)) :
    ∃ (after : State) (calls : List WriteCall) (aligned : Bool),
      Mem_set__2 a N acc pair high value s = .ok () after ∧ WriteChain s calls after ∧
      calls.map WriteCall.request = byteAccess offsetBase a acc false 0 ::
        (List.range' 1 (N - 1)).map (byteAccess offsetBase a acc aligned) ∧
      ∀ call ∈ calls, ByteWitness offsetBase 0 1 a acc false value pa call ∨
        ByteWitness offsetBase 1 (N - 1) a acc aligned value pa call := by
  have positive : 0 < N := by rcases hn with rfl | rfl <;> omega
  have small : N ≤ 16 := by rcases hn with rfl | rfl <;> omega
  rcases storePlan_run positive small offsetBase a acc value hA shape pa mapped ram outside
    s pins.host pins.alignment_disabled plain current statusRows permit with ⟨after,calls,aligned,run,chain,requests,witness⟩
  refine ⟨after,calls,aligned,?_,chain,requests,witness⟩
  rw [store_bytes_low_eq a N hn pair high unaligned acc hA plain value s profile pins current.post notJoin lowOrder]
  exact run

#print axioms store_bytes_low_order
end PairDefault236.BytePlans
