theorem storeSuffix_run {N : Nat} (positive : 0 < N) (small : N ≤ 16)
    (offsetBase : Nat) (a : BitVec 64) (acc : AccessDescriptor)
    (value : BitVec (N * 8)) (hA : AccDWT acc) (shape : DataShape true acc)
    (pa : Fin N → BitVec 56)
    (mapped : ∀ j : Fin N, mapping (BitVec.addInt a (j.val : Int)) = some (pa j).toNat)
    (ram : ∀ j : Fin N, NotMMIO (pa j))
    (outside : ∀ j : Fin N, ¬ (rowsFootprint spec.imageRows).byte (pa j).toNat)
    (s : State)
    (current : Current.At spec config rows mapping m catalogue s)
    (statusRows : TagStatusRows s (s.choiceOcc.getD 1354 0) N)
    (permit : ∀ prepared, DataShape true prepared → ∀ (j : Fin N) (aligned : Bool),
      m.permitted (BitVec.addInt a (j.val : Int)) prepared aligned (1 : Int)) :
    ∃ (after : State) (calls : List WriteCall) (aligned : Bool),
      storeSuffix a N acc value s = .ok () after ∧ WriteChain s calls after ∧
      calls.map WriteCall.request = byteAccess offsetBase a acc false 0 ::
        (List.range' 1 (N - 1)).map (byteAccess offsetBase a acc aligned) ∧
      ∀ call ∈ calls, ByteWitness offsetBase 0 1 a acc false value pa call ∨
        ByteWitness offsetBase 1 (N - 1) a acc aligned value pa call := by
  rcases write_iterate small offsetBase a acc false value hA shape pa mapped ram outside
    0 1 (by omega) s current (TranslateSpan.DefaultMTE2.rows_after_delta s s N 1 0 statusRows (choice_delta_refl s) (by omega)) (fun prepared sh j => permit prepared sh j false) with
    ⟨s1,firstCalls,firstRun,firstChain,cur1,firstRequests,firstWitness⟩
  have firstBody : writeBody a N acc false value 0 () s = .ok () s1 := by
    simpa [iterate] using firstRun
  rcases NativeAccess.Logical.devpage_allowed s1 with ⟨c,s2,choice,allowed,choiceFrame⟩
  have choiceDelta := Control.devpage_preserves s1 c s2 choice
  have choiceTrace : TraceFrame s1 s2 := ⟨choiceFrame.1,choiceFrame.2.1,choiceFrame.2.2,choiceDelta⟩
  let aligned := c == Constraint.Constraint_NONE
  rcases write_range small offsetBase a acc aligned value hA shape pa mapped ram outside
    1 (N - 1) (by omega) s2 (cur1.frame choiceFrame)
    (by
      obtain ⟨used,delta,bound⟩ := firstChain.choice
      have callCount : firstCalls.length = 1 := by simpa using congrArg List.length firstRequests
      exact TranslateSpan.DefaultMTE2.rows_after_delta s s2 N (N - 1) used statusRows
        (by simpa using choice_delta_trans delta choiceDelta) (by omega)) (fun prepared sh j => permit prepared sh j aligned) with
    ⟨s3,tailCalls,tailRun,tailChain,cur3,tailRequests,tailWitness⟩
  refine ⟨s3,firstCalls ++ tailCalls,aligned,?_,
    chain_append firstChain (chain_prepend choiceTrace tailChain),?_,?_⟩
  · have one : ((1 : Nat) : Int) = 1 := by decide
    simp only [one] at tailRun
    have stop : (N : Int) - 1 = (1 : Int) + ((N - 1 : Nat) : Int) - 1 := by omega
    unfold storeSuffix
    simp only [Bind.bind,EStateM.bind,firstBody,choice]
    rw [stop]
    exact tailRun
  · rw [List.map_append,firstRequests,tailRequests]
    rfl
  · intro call memberCall
    rcases List.mem_append.mp memberCall with left | right
    · exact Or.inl (firstWitness call left)
    · exact Or.inr (tailWitness call right)

