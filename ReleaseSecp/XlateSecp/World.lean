def dataRanges : List (Nat × Nat) := [(0x80600000, 32), (0x80601000, 32), (0x80602000, 32), (0x80603fc0, 64)]
def dataPlan : List (Nat × BitVec 8) := dataRanges.flatMap fun r => (List.range r.2).map fun i => (r.1 + i, 0#8)

def tablePlan : List (Nat × BitVec 8) := imageRowsPlan imageRows

/-- The whole byte plan, ascending by address: tables (0x80000000..), data (0x80600000..), image (0x80701638..). -/
def plan : List (Nat × BitVec 8) := tablePlan ++ dataPlan ++ imagePlan

/-- Adjacent plan addresses strictly increase (a linear check). -/
def sortedB : List (Nat × BitVec 8) → Bool
  | [] => true
  | [_] => true
  | a :: b :: t => decide (a.1 < b.1) && sortedB (b :: t)

theorem sorted_head : ∀ (a : Nat × BitVec 8) (l : List (Nat × BitVec 8)), sortedB (a :: l) = true →
    ∀ c ∈ l, a.1 < c.1
  | _, [], _, c, hc => absurd hc (by simp)
  | a, b :: t, h, c, hc => by
    simp only [sortedB, Bool.and_eq_true, decide_eq_true_eq] at h
    rcases List.mem_cons.1 hc with rfl | hc
    · exact h.1
    · exact Nat.lt_trans h.1 (sorted_head b t h.2 c hc)

theorem pairwise_of_sorted : ∀ (l : List (Nat × BitVec 8)), sortedB l = true →
    l.Pairwise (fun a b => (a.1 == b.1) = false)
  | [], _ => List.Pairwise.nil
  | [a], _ => List.pairwise_singleton _ a
  | a :: b :: t, h => by
    have hrest : sortedB (b :: t) = true := by
      simp only [sortedB, Bool.and_eq_true] at h; exact h.2
    refine List.Pairwise.cons (fun c hc => ?_) (pairwise_of_sorted (b :: t) hrest)
    have := sorted_head a (b :: t) h c hc
    simp only [beq_eq_false_iff_ne, ne_eq]; omega

theorem plan_sorted : sortedB plan = true := by decide +kernel

theorem planKeys : plan.Pairwise (fun a b => (a.1 == b.1) = false) := pairwise_of_sorted plan plan_sorted

/-! ## Per-card entry data -/

/-- A card's caller data: entry offset `pc` and the x1/x2 buffer pointers (x0 = 0x30000 always). Aliasing
variants (`plan.normalize ≠ id`) put the aliased pins on the same buffer. -/
structure Card where
  pc : Nat
  x1 : BitVec 64
  x2 : BitVec 64

/-- Entry data for card `c`: x0 = 0x30000, x1/x2 per card, x30 = base (return VA < 2^55), SP_EL0 = 0x50000,
PC = base + c.pc, TTBR0_EL2 = HTTBR = table root, generic timers disabled (0). -/
def data (c : Card) : DataPart where
  gpr := Vector.ofFn fun i =>
    if i.val = 0 then 0x30000#64 else if i.val = 1 then c.x1 else if i.val = 2 then c.x2
    else if i.val = 30 then 0x400000#64 else 0#64
  SP_EL3 := 0#64
  SP_EL2 := 0#64
  SP_EL1 := 0#64
  SP_EL0 := 0x50000#64
  _ZT0 := 0#512
  _ZA := Vector.replicate 256 0#2048
  _FFR := 0#256
  _P := Vector.replicate 16 0#256
  _Z := Vector.replicate 32 0#2048
  PhysicalCount := 0#88
  _PC := base + BitVec.ofNat 64 c.pc
  TTBR0_EL2 := 0x80000000#128
  TTBR1_EL2 := 0#128
  HTTBR := 0x80000000#64
  timers := fun _ => 0#64

def payload (c : Card) (pcount : BitVec 88) : ModelPayload :=
  ⟨{ data c with PhysicalCount := pcount }, Std.ExtHashMap.ofList plan⟩

/-- The source-built entry of card `c`. -/
def entry (sem : ModelSemantics) (rho : AdmissibleSourceCompletion) (caller : AdmissibleCaller rho)
    (c : Card) (pcount : BitVec 88) : ArmBridge.Draft.NativeState :=
  makeModelEntry sem rho caller (payload c pcount)

/-- Every planned byte is present in the entry memory. -/
theorem entry_realizes (sem : ModelSemantics) (rho : AdmissibleSourceCompletion) (caller : AdmissibleCaller rho)
    (c : Card) (pcount : BitVec 88) : ∀ ab ∈ plan, (entry sem rho caller c pcount).mem[ab.1]? = some ab.2 :=
  fun ⟨_, _⟩ mem => Std.ExtHashMap.getElem?_ofList_of_mem (BEq.refl _) planKeys mem

theorem entry_realizes_table (sem : ModelSemantics) (rho : AdmissibleSourceCompletion) (caller : AdmissibleCaller rho)
    (c : Card) (pcount : BitVec 88) : ∀ ab ∈ tablePlan, (entry sem rho caller c pcount).mem[ab.1]? = some ab.2 :=
  fun ab mem => entry_realizes sem rho caller c pcount ab (by simp [plan, mem])

/-- The entry PC is the card's first code word (`a78` shape). -/
theorem entry_pc (sem : ModelSemantics) (rho : AdmissibleSourceCompletion) (caller : AdmissibleCaller rho)
    (c : Card) (pcount : BitVec 88) : (entry sem rho caller c pcount).regs._PC = base + BitVec.ofNat 64 c.pc := rfl

end XlateSecp.World

