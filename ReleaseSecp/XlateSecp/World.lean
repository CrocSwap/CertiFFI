import ReleaseProfile.GB10.ModelEntry
import ArmCertTranslateModel.PlanChecks
import ReleaseProfile.GB10.TablesBuilder
import TranslateSpan.SecpRawDeployment
import TranslateSpan.CheckedTopology
import SecpArtifact.Elf

set_option autoImplicit false
set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-!
# SecpWorld: shared C2 world for the 32 secp cards (Translate, next train; speed mode: compiles, not verified)

Program/memory/caller data only (the HeapWorldData analogue). Configuration is never constructed here:
`raw rho caller` takes params/controls from a source-pinned spec (`sourceSpec_exists`), the attribute
config is `sourceAttributes rho caller`, and the entry is `makeModelEntry` over `sourceRegs`.

Layout (VA → PA, 4 KiB pages; tables at root 0x80000000):
- image: load base 0x400000; ELF d036c327 RX PT_LOAD (file 0x638, vaddr 0x1638, size 0xb1c) on pages
  0x401/0x402 → 0x80701000/0x80702000;
- buffers: x0 0x30000 → 0x80600000, x1 0x31000 → 0x80601000, x2 0x32000 → 0x80602000 (32 B each, zero, reduced);
- stack page 0x4f → 0x80603000 (SP_EL0 = 0x50000, 64 B below it zero).
-/

namespace XlateSecp.World

open ArmFull ArmCertWalk ArmCert.Translate ArmCert.Translate.Model ReleaseProfile.GB10 ReleaseProfile.MachineSource

/-- Load base (VA of image offset 0), page aligned. -/
def base : BitVec 64 := 0x400000#64

/-! ## Tables -/

def viewOf (word : BitVec 64) : S1DescriptorPIE.View 64 := S1DescriptorPIE.view false true true word

/-- (slot, leaf, descriptor word): root → L1 → L2; L3 leaves for data pages 0x30/0x31/0x32, stack 0x4f,
and image pages 0x400/0x401/0x402. -/
def tableWords : List (Nat × Bool × BitVec 64) :=
  [(0x80000000, false, 0x80001003), (0x80001000, false, 0x80002003), (0x80002000, false, 0x80003003),
   (0x80002010, false, 0x80004003), (0x80003180, true, 0x68000080600743), (0x80003188, true, 0x68000080601743),
   (0x80003190, true, 0x68000080602743), (0x80003278, true, 0x68000080603743), (0x80004000, true, 0x200000807007c3),
   (0x80004008, true, 0x200000807017c3), (0x80004010, true, 0x200000807027c3)]

def logicalRows : List LogicalRow := tableWords.map fun (slot, _, word) =>
  ⟨slot, ⟨.PAS_NonSecure, BitVec.ofNat 56 slot⟩, viewOf word⟩

def imageRows : List ImageRow := tableWords.map fun (slot, leaf, word) => ⟨slot, leaf, word, viewOf word⟩

def layout : S1LogicalReference.Layout := ⟨0, 48, 0x80000000⟩

theorem rows_valid : checkSpecRows logicalRows imageRows = true := by decide

/-- The World tables as program data for the canonical raw producer. -/
def tables : TranslateSpan.CheckedTopology.Tables := ⟨layout, logicalRows, imageRows⟩

/-- VA→PA over the mapped pages. -/
def mapping : BitVec 64 → Option Nat := fun va =>
  let page := va.toNat / 4096
  let offset := va.toNat % 4096
  if page = 0x30 then some (0x80600000 + offset) else if page = 0x31 then some (0x80601000 + offset)
  else if page = 0x32 then some (0x80602000 + offset) else if page = 0x4f then some (0x80603000 + offset)
  else if page = 0x400 then some (0x80700000 + offset) else if page = 0x401 then some (0x80701000 + offset)
  else if page = 0x402 then some (0x80702000 + offset)
  else none

/-! ## Permission rows (one per page × access kind; Heap's row shape) -/

/-- Native permission witness read off the descriptor bits and the walked table prior (Heap's shape). -/
def witnessOf (tbl : S1LogicalReference.TablePermissions) (raw : BitVec 64) : ArmFull.Permissions :=
  let b : ArmFull.Permissions := default
  { b with
    ap_table := tbl.ap
    pxn_table := BitVec.ofBool tbl.pxn
    uxn_table := BitVec.ofBool tbl.uxn
    ap := ((raw.extractLsb' 6 2).setWidth 3) <<< 1
    pxn := BitVec.ofBool (raw.getLsbD 53)
    uxn := BitVec.ofBool (raw.getLsbD 54) }

/-- Table-walk prior (all table descriptors carry zero AP/PXN/UXN table bits). -/
def tablePrior : S1LogicalReference.TablePermissions := ⟨0#2, false, false⟩

/-- Normal inner/outer write-back attributes (MAIR index 0), untagged, XS = 0. -/
def wbAttributes : AttributeBody :=
  { kind := .normal { attrs := 3#2, hints := some 3#2, transient := some false }
      { attrs := 3#2, hints := some 3#2, transient := some false }
    tags := .MemTag_Untagged, noTagAccess := false, xs := 0#1 }

def fetchAcc : AccessDescriptor :=
  { (default : AccessDescriptor) with acctype := .AccessType_IFETCH, el := 0#2, ss := .SS_NonSecure }
def readAcc : AccessDescriptor :=
  { (default : AccessDescriptor) with acctype := .AccessType_GPR, el := 0#2, ss := .SS_NonSecure, read := true, write := false }
def writeAcc : AccessDescriptor :=
  { (default : AccessDescriptor) with acctype := .AccessType_GPR, el := 0#2, ss := .SS_NonSecure, read := false, write := true }

def rowOf (slot : Nat) (raw : BitVec 64) (acc : AccessDescriptor) : PermissionRow :=
  { slot := slot, raw := raw, prior := tablePrior, attributes := wbAttributes, access := acc,
    witness := witnessOf tablePrior raw }

def dataLeaves : List (Nat × BitVec 64) :=
  [(0x80003180, 0x68000080600743), (0x80003188, 0x68000080601743), (0x80003190, 0x68000080602743),
   (0x80003278, 0x68000080603743)]
def codeLeaves : List (Nat × BitVec 64) :=
  [(0x80004008, 0x200000807017c3), (0x80004010, 0x200000807027c3)]

def permissionRows : List PermissionRow :=
  codeLeaves.map (fun (s, w) => rowOf s w fetchAcc) ++
  dataLeaves.map (fun (s, w) => rowOf s w readAcc) ++ dataLeaves.map (fun (s, w) => rowOf s w writeAcc)

