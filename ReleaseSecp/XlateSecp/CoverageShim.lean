theorem reviewed_range : reviewedWords.map (·.1) = (List.range 711).map (fun k => 0x1638 + 4 * k) := by decide +kernel

def sext (v bits : Nat) : Int := if v ≥ 2 ^ (bits - 1) then (v : Int) - (2 ^ bits : Nat) else (v : Int)

def directTarget (o w : Nat) : Option Int :=
  if w &&& 0x7C000000 == 0x14000000 then some ((o : Int) + 4 * sext (w &&& 0x3FFFFFF) 26)
  else if w &&& 0xFF000000 == 0x54000000 then some ((o : Int) + 4 * sext ((w >>> 5) &&& 0x7FFFF) 19)
  else if w &&& 0x7E000000 == 0x34000000 then some ((o : Int) + 4 * sext ((w >>> 5) &&& 0x7FFFF) 19)
  else if w &&& 0x7E000000 == 0x36000000 then some ((o : Int) + 4 * sext ((w >>> 5) &&& 0x3FFF) 14)
  else none

def isRegBranch (w : Nat) : Bool := w &&& 0xFE000000 == 0xD6000000
def isRet (w : Nat) : Bool := w == 0xD65F03C0
def isExcGen (w : Nat) : Bool := w &&& 0xFF000000 == 0xD4000000
def isB (w : Nat) : Bool := w &&& 0xFC000000 == 0x14000000

def inScope (t : Int) : Bool := decide (0x1638 ≤ t) && decide (t < 0x2154) && decide (t % 4 = 0)

def wordOk (o w : Nat) : Bool :=
  (!isRegBranch w || isRet w) && !isExcGen w &&
  (match directTarget o w with | some t => inScope t | none => true) &&
  (isB w || isRet w || inScope ((o : Int) + 4))

theorem reviewed_closed : reviewedWords.all (fun c => wordOk c.1 c.2) = true := by decide +kernel

/-- The 10 exported `certiffi_bignum_*_dit` shims. -/
def entries : List Nat := [0x1f9c, 0x1fc8, 0x1ff4, 0x2020, 0x204c, 0x2078, 0x20a4, 0x20d0, 0x20fc, 0x2128]
theorem entries_reviewed : entries.all (fun e => inScope e) = true := by decide +kernel

def reviewedImageBytes : Array (Nat × Nat) :=
  (reviewedWords.flatMap fun c => (List.range 4).map fun i => (c.1 + i, (c.2 >>> (8 * i)) % 256)).toArray

/-- The gate's reviewed byte table (BYTE_EQUAL) is exactly the byte expansion of the fetch-reviewed words. -/
theorem reviewedImageBytes_eq : reviewedImageBytes =
    (reviewedWords.flatMap fun c => (List.range 4).map fun i => (c.1 + i, (c.2 >>> (8 * i)) % 256)).toArray := rfl

end XlateSecp.CoverageShim

#print axioms XlateSecp.CoverageShim.reviewed_closed
#print axioms XlateSecp.CoverageShim.reviewedImageBytes_eq
