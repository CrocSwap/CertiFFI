theorem sub_dynamic : dynamicEntries elf = SecpSubPlanScoped.slices.dynamic := by
  rw [dynamicEntries, sub_programHeaders]
  change [(u64 elf 4440,u64 elf 4448),
    (u64 elf 4456,u64 elf 4464),
    (u64 elf 4472,u64 elf 4480),
    (u64 elf 4488,u64 elf 4496),
    (u64 elf 4504,u64 elf 4512),
    (u64 elf 4520,u64 elf 4528),
    (u64 elf 4536,u64 elf 4544),
    (u64 elf 4552,u64 elf 4560),
    (u64 elf 4568,u64 elf 4576),
    (u64 elf 4584,u64 elf 4592),
    (u64 elf 4600,u64 elf 4608)].takeWhile (fun p : Nat × Nat => p.1 != 0) = _
  simp only [dynamicWord_4440, dynamicWord_4448, dynamicWord_4456, dynamicWord_4464, dynamicWord_4472, dynamicWord_4480, dynamicWord_4488, dynamicWord_4496, dynamicWord_4504, dynamicWord_4512, dynamicWord_4520, dynamicWord_4528, dynamicWord_4536, dynamicWord_4544, dynamicWord_4552, dynamicWord_4560, dynamicWord_4568, dynamicWord_4576, dynamicWord_4584, dynamicWord_4592, dynamicWord_4600, dynamicWord_4608]
  rfl

private theorem rela_of_absent (bytes : Array Nat)
    (seven : dynamicValue bytes 7 = none) (eight : dynamicValue bytes 8 = none) :
    relaTable bytes = some [] := by
  simp only [relaTable,seven,eight]

private theorem dynamic_absent (tag : Nat)
    (h : (SecpSubPlanScoped.slices.dynamic.find? (·.1 == tag)).isNone = true) :
    dynamicValue elf tag = none := by
  unfold dynamicValue
  rw [sub_dynamic]
  cases found : SecpSubPlanScoped.slices.dynamic.find? (·.1 == tag)
  · rfl
  · simp [found] at h

theorem sub_rela : relaTable elf = some SecpSubPlanScoped.slices.rela :=
  rela_of_absent elf (dynamic_absent 7 (by rfl)) (dynamic_absent 8 (by rfl))


theorem sub_binds : Binds elf SecpSubPlanScoped.slices := by
  refine ⟨sub_size,?_,sub_programHeaders,sub_dynamic,sub_rela⟩
  intro i hi
  exact beq_iff_eq.mp (List.all_eq_true.mp sub_header_check i (List.mem_range.mpr hi))

set_option maxHeartbeats 1500000 in
theorem sub_code_check :
    SecpSubPlanE17.codeVAs.eraseDups.all (fun (c : Nat × Nat) =>
      (List.range 4).all (fun i =>
        byte elf (1592 + (c.1 - 5688) + i) == (c.2 >>> (8 * i)) % 256)) = true := by
  rfl

theorem sub_code_binds : SecpSubPlanE17.CodeBinds elf := by
  intro c hc i hi
  exact beq_iff_eq.mp (List.all_eq_true.mp (List.all_eq_true.mp sub_code_check c (List.mem_eraseDups.mpr hc)) i
    (List.mem_range.mpr hi))

