  intro j hj
  have hjn : j < n0_c00 := by
    by_cases h : j < n0_c00
    · exact h
    · exfalso
      rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by rw [pIn_length]; omega)] at hj
      simp at hj
  have hd : tl ≤ j ∧ j < tl + 31 ∧ j - tl ≠ 9 ∧ j - tl ≠ 30 ∧ j - tl ≠ 1 := by
    simpa [pIn, List.getD_eq_getElem?_getD, hjn] using hj
  obtain ⟨lo, hi, n9, n30, n1⟩ := hd
  have htl : totalL EntryBinding.plan.regions = tl := rfl
  have e1 := SecpCurrentEntry.inputs_gpr EntryBinding.plan m1 s1 (j - tl) (by omega)
  have e2 := SecpCurrentEntry.inputs_gpr EntryBinding.plan m2 s2 (j - tl) (by omega)
  rw [htl, show tl + (j - tl) = j by omega] at e1 e2
  unfold Default.inputs
  rw [e1, e2]
  unfold entryGPR
  rw [dite_eq_left (by omega), dite_eq_left (by omega)]
  exact hg ⟨j - tl, by omega⟩ n9 n30 n1

