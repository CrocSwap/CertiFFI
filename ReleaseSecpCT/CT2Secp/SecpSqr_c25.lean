section Entry
variable (real : Type) [Sail.SailReal real]
    (raw : CheckedTopology.Raw) (config : AttributeConfig) (rows : List PermissionRow)
    (mapping : BitVec 64 → Option Nat) (base : BitVec 64)
    (start : Nat) (imm : BitVec 26) (pins : HeapV2E17.Pins) (entry : NativeState) (catalogue : NativeMteTagCheck.ControlCatalogue)
    (gt : CheckedTopology.check raw (Deployment.addresses EntryBinding.plan base entry start imm (BitVec.ofNat 64 pins.sp)) 4 = true)
    (rt : CheckedTopology.check raw (SecpRawDeployment.addresses EntryBinding.plan base entry) 4 = true)
    (info : Initial.Info EntryBinding.plan raw config rows mapping base (referenceImageI SecpArtifact.elf base (fun _ => 0))
      start imm 135 pins (DefaultState.capacity entry + 2) entry catalogue gt rt)

include info

/-- CT2 frame facts for one run of card SecpSqr_c25 (generated by env ct2/gen_secp_ct2.py; proof copied from Shim32Run.of_initial). -/
theorem ct2_frame :
    (∀ i : Fin 31, i.val ≠ 9 → i.val ≠ 30 →
      (stateAt real entry 147).regs.gpr[i.val] = (stateAt real entry 143).regs.gpr[i.val]) ∧
    ValuePlan.AgreesAt .g (view EntryBinding.plan mapping (stateAt real entry 7)) regions_c00 σ0_c00
      (Default.inputs mapping (stateAt real entry 7))
      (plan_c00 ((stateAt real entry 7).regs.bank_BitVec_64 .TPIDR_EL0)) 136 (stateAt real entry 143) ∧
    (∀ i : Fin 31, i.val ≠ 9 → i.val ≠ 30 → (stateAt real entry 7).regs.gpr[i.val] = entry.regs.gpr[i.val]) ∧
    (stateAt real entry 147).regs.gpr[30] = entry.regs.gpr[30] ∧
    (stateAt real entry 147).regs.gpr[9] = (stateAt real entry 3).regs.gpr[9] ∧
    (stateAt real entry 147).regs.SP_EL0 = entry.regs.SP_EL0 ∧
    (∀ i : Fin 31, 18 ≤ i.val → (stateAt real entry 147).regs.gpr[i.val] = entry.regs.gpr[i.val]) ∧
    (stateAt real entry 3).regs.gpr[9] = CT2Core.ditImage entry.regs.PSTATE.DIT := by
  obtain ⟨pre,savedDIT⟩ := Prologue.of_initial real EntryBinding.plan raw config rows mapping base _ start imm 135 pins (DefaultState.capacity entry+2) entry catalogue gt rt info
  obtain ⟨returned,sp31,slot31,ctl31,⟨used,delta,usedBound⟩,dit31⟩ := DitBodyExit.of_pre real raw config rows mapping base start imm pins entry catalogue gt rt info pre
  have aligned := Geometry.whole_aligned start (InitialCheck.rawPC EntryBinding.plan) 135 base (entryGPR entry 30) info.metadata.startAligned info.metadata.bodyAligned
  have offPre' : ∀ j, j ≤ 6 → InitialCheck.runOffset EntryBinding.plan start 135 base entry j = Geometry.shimPC start j := by
    intro j hj; exact Geometry.whole_prefix start (InitialCheck.rawPC EntryBinding.plan) 135 j base (entryGPR entry 30) hj
  have offPost' : ∀ j, 143 ≤ j → j ≤ 146 → InitialCheck.runOffset EntryBinding.plan start 135 base entry j = Geometry.shimPC start (j-136) := by
    intro j lo hi; exact Geometry.whole_epilogue start (InitialCheck.rawPC EntryBinding.plan) 135 j base (entryGPR entry 30) lo hi
  have straight : ∀ j, 143 ≤ j → j ≤ 145 → InitialCheck.runOffset EntryBinding.plan start 135 base entry (j+1) = InitialCheck.runOffset EntryBinding.plan start 135 base entry j + 4#64 := by
    intro j lo hi
    rw [offPost' (j+1) (by omega) (by omega),offPost' j lo (by omega),show j+1-136=(j-136)+1 by omega]
    exact Geometry.shimPC_succ start _
  have slotPerm := Deployment.slot_permitted EntryBinding.plan raw mapping base entry start imm pins info.metadata.slotAligned
  have status31 := DefaultMTE2.rows_after_delta entry (stateAt real entry 143) (DefaultState.capacity entry+2) 1 used info.status delta (by omega)
  have low3 : (stateAt real entry 3).regs.gpr[30].toNat < 2^55 := by
    rw [pre.x30_3]; exact info.metadata.returnLow
  have target3 : (stateAt real entry 3).regs.gpr[30] = base + InitialCheck.runOffset EntryBinding.plan start 135 base entry 147 := by
    rw [pre.x30_3]
    exact Geometry.caller_target start (InitialCheck.rawPC EntryBinding.plan) 135 base (entryGPR entry 30)
  obtain ⟨epiRuns,finalInv,lr,x9,sp,mem,dit,keep,epiControl,⟨epiUsed,epiDelta,epiBound⟩,epiInvs,epiControls,epiWindow,dit34,lr34⟩ :=
    Factory.epilogue real 135 _ config rows mapping pins _ start imm _ _ base info.code.separated
      (InitialCheck.runOffset EntryBinding.plan start 135 base entry) 147 catalogue entry (stateAt real entry 3)
      (by decide) info.metadata.page aligned straight info.metadata.nodup slotPerm info.slots info.metadata.slotAligned returned
      info.metadata.mrs info.metadata.isb ctl31 info.code offPre' offPost' status31 sp31 slot31 low3 target3
  have pinsChecked : DataFrame.checkPins EntryBinding.plan = true := by decide
  have agree := DataTransport.of_pre real 135 _ config rows mapping pins _ start _ _ base base _ 147 _ (DefaultState.capacity entry+2) entry pre EntryBinding.plan pinsChecked
  obtain ⟨rt7,receipt⟩ := DitBodyEntry.of_pre real raw config rows mapping base start imm pins entry catalogue gt rt info pre
  obtain ⟨_,bodyRuns,_,fin,last,finEq,ssa,frame,pc,bodyUsed,bodyDelta,bodyBound⟩ := DitBodyRun.run real raw config rows mapping base (stateAt real entry 7) rt7 receipt
  have shift := StateShift.stateAt_add real entry 7 136
  rw [finEq, ← shift] at ssa
  -- full MRS DIT image of x9 at state 3: the MRS step value, with its DIT pinned by savedDIT
  have prof2 := DitShim243.Profiles.mrs info.metadata.mrs (DitShim243.Profiles.features (pre.controlPrefix 2 (by omega)))
  have fetches2 := DitShim243.Fetches.of_static 135 _ config rows mapping _ _ _ base
    (InitialCheck.runOffset EntryBinding.plan start 135 base entry) 147 catalogue start imm info.code offPre' offPost'
  obtain ⟨fin9, run9, saved9, _, _⟩ := DefaultHeapShimEffects.shim_mrs9 real _ config rows mapping _ _ _ base base
    (InitialCheck.runOffset EntryBinding.plan start 135 base entry) 147 2 catalogue (by omega) info.metadata.page
    (aligned 2 (by omega)) _ (pre.inv 2 (by omega)) prof2 (fetches2.ob2 _ (pre.inv 2 (by omega)))
  have e9 : stateAt real entry 3 = fin9 := RtDit.stateAt_succ_of run9
  rw [← e9] at saved9
  have d2 : (stateAt real entry 2).regs.PSTATE.DIT = entry.regs.PSTATE.DIT := by
    have h := savedDIT; rw [saved9, DitShim243.Utils.enc_bit] at h; exact h
  have x9full : (stateAt real entry 3).regs.gpr[9] = CT2Core.ditImage entry.regs.PSTATE.DIT := by
    rw [saved9, d2]; rfl
  refine ⟨keep, ssa, pre.keepPre, lr.trans pre.x30_3, x9, ?_, ?_, x9full⟩
  · rw [sp, sp31]; exact info.metadata.sp.symm
  · have memberTable : ∀ i : Fin 31, 18 ≤ i.val → (RegBind.Reg.x i) ∈ DitBodyABI.preservedRegisters := by decide
    intro i lower
    by_cases lastReg : i.val = 30
    · have equal : i = (30 : Fin 31) := Fin.ext lastReg
      subst i
      exact lr.trans pre.x30_3
    · have rawKept := DitBodyABI.preserved_of_agrees mapping (stateAt real entry 7) (stateAt real entry 143) ssa (.x i) (memberTable i lower)
      exact (keep i (by omega) lastReg).trans (rawKept.trans (pre.keepPre i (by omega) lastReg))

end Entry
#print axioms ct2_frame

/-- ct2_frame from the card's sealed check (the path the CT0 FromSource root takes: residual -> check). -/
theorem ct2_frame_of_check (real : Type) [Sail.SailReal real] (raw : CheckedTopology.Raw) (config : AttributeConfig)
    (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat) (base : BitVec 64) (pins : HeapV2E17.Pins)
    (entry : NativeState) (catalogue : NativeMteTagCheck.ControlCatalogue)
    (checked : Shim32Exact.check raw config rows mapping base pins entry catalogue = true) :
    (∀ i : Fin 31, i.val ≠ 9 → i.val ≠ 30 →
      (stateAt real entry 147).regs.gpr[i.val] = (stateAt real entry 143).regs.gpr[i.val]) ∧
    ValuePlan.AgreesAt .g (view EntryBinding.plan mapping (stateAt real entry 7)) regions_c00 σ0_c00
      (Default.inputs mapping (stateAt real entry 7))
      (plan_c00 ((stateAt real entry 7).regs.bank_BitVec_64 .TPIDR_EL0)) 136 (stateAt real entry 143) ∧
    (∀ i : Fin 31, i.val ≠ 9 → i.val ≠ 30 → (stateAt real entry 7).regs.gpr[i.val] = entry.regs.gpr[i.val]) ∧
    (stateAt real entry 147).regs.gpr[30] = entry.regs.gpr[30] ∧
    (stateAt real entry 147).regs.gpr[9] = (stateAt real entry 3).regs.gpr[9] ∧
    (stateAt real entry 147).regs.SP_EL0 = entry.regs.SP_EL0 ∧
    (∀ i : Fin 31, 18 ≤ i.val → (stateAt real entry 147).regs.gpr[i.val] = entry.regs.gpr[i.val]) ∧
    (stateAt real entry 3).regs.gpr[9] = CT2Core.ditImage entry.regs.PSTATE.DIT := by
  obtain ⟨gt, rt, conditions⟩ := InitialCheck.of_check EntryBinding.plan raw config rows mapping base _ 8356 (67108531#26) 135 pins
    (DefaultState.capacity entry+2) entry catalogue checked
  have info := Initial.of_conditions EntryBinding.plan raw config rows mapping base _ 8356 (67108531#26) 135 pins
    (DefaultState.capacity entry+2) entry catalogue gt rt conditions
  exact ct2_frame real raw config rows mapping base 8356 (67108531#26) pins entry catalogue gt rt info
#print axioms ct2_frame_of_check
end CT2Secp.SecpSqr_c25
