theorem explicit_of_gpr (acc : AccessDescriptor) (h : acc.acctype = .AccessType_GPR) :
    ∃ k, AccessDescriptor_to_Access_kind acc = .AK_explicit k := by
  unfold AccessDescriptor_to_Access_kind
  simp [h]

/-- records of a list of data accesses (VA, size): per access its translation traffic, then the access record. -/
def vaRecs {domain : QueryDomain} (spec : TopologyImageSpec domain) (write : Bool) (vs : List (BitVec 64 × Nat)) :
    List (Option ArmCertCTOrdered.OrderedEventV2.Record) :=
  vs.flatMap (fun p => (trafficRecsOf spec p.1).map (Option.map .traffic) ++
    [some (.access ⟨if write then .write else .read, p.1, p.2⟩)])

theorem accessRecs_flat {domain : QueryDomain} (spec : TopologyImageSpec domain) (write : Bool)
    (rs : List NativeAccess.Trace.Access) :
    rs.flatMap (TranslateSpan.AccessChainRecords.accessRecs spec write) = vaRecs spec write (rs.map fun r => (r.va, r.bytes)) := by
  induction rs with
  | nil => rfl
  | cons r rs ih =>
    simp only [List.flatMap_cons, List.map_cons, vaRecs] at ih ⊢
    rw [ih]
    simp [TranslateSpan.AccessChainRecords.accessRecs]

def oneVAS (A : BitVec 64) : List (BitVec 64 × Nat) := [(A, 16)]
def splitVAS (A : BitVec 64) : List (BitVec 64 × Nat) := [(A, 8), (BitVec.addInt A ((8 : Nat) : Int), 8)]
def bytesVAS (A : BitVec 64) : List (BitVec 64 × Nat) :=
  (BitVec.addInt A ((0 : Nat) : Int), 1) :: (List.range' 1 15).map (fun i => (BitVec.addInt A (i : Int), 1))

end SecpCt.PairRecs

