/-! GENERATED from actual post-retired epilogue. The concrete
successor retains all oracle bookkeeping. Taken branches retain their actual
PC; only the untaken branch advances it by the actual instruction length. -/

def nativeAtCounter : NativeState → EStateM.Result (Sail.Error exception) NativeState Unit :=
fun afterFetch =>
  ArmBridge.CruxCore.bind_app.match_1
    (fun x =>
      EStateM.Result (Sail.Error ArmFull.exception)
        (Sail.ConcurrencyInterfaceV1.SequentialState ArmFull.Regs Sail.ConcurrencyInterfaceV1.oracleChoiceSource) Unit)
    (ArmFull.Functions.__UpdateSystemCounter Unit.unit afterFetch)
    (fun a s' =>
      ArmBridge.CruxCore.bind_app.match_1
        (fun x =>
          EStateM.Result (Sail.Error ArmFull.exception)
            (Sail.ConcurrencyInterfaceV1.SequentialState ArmFull.Regs Sail.ConcurrencyInterfaceV1.oracleChoiceSource)
            Unit)
        (ArmFull.Functions.UsingAArch32 Unit.unit s')
        (fun a s' =>
          cond a
            (Bind.bind (ArmFull.Functions.AArch32_PMUCycle Unit.unit) fun __r => ArmFull.Functions.__EndCycle Unit.unit)
            (Bind.bind (ArmFull.Functions.AArch64_PMUCycle Unit.unit) fun __r => ArmFull.Functions.__EndCycle Unit.unit)
            s')
        fun e s' => EStateM.Result.error e s')
    fun e s' => EStateM.Result.error e s'

