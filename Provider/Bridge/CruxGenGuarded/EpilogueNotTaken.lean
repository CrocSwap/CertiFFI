theorem beforeCounterNotTaken_fields (s : NativeState)
    (hel : s.regs.PSTATE.EL = 0#2) (hnrw : s.regs.PSTATE.nRW = 0#1) :
    GuardFieldsEq s (beforeCounterNotTaken s) := by
  constructor
  all_goals first | rfl | exact hel.symm | exact hnrw.symm | (intro k hk; rfl)

theorem beforeCounterNotTaken_quiet (ticks : Nat) (s : NativeState) (hq : HookQuiet ticks s) :
    HookQuiet ticks (beforeCounterNotTaken s) :=
  quiet_of_fields ticks s _ hq (beforeCounterNotTaken_fields s hq.el0 hq.nrw)

theorem beforeCounterNotTaken_mem (s : NativeState) : (beforeCounterNotTaken s).mem = s.mem := rfl
theorem beforeCounterNotTaken_events (s : NativeState) : (beforeCounterNotTaken s).events = s.events := rfl
theorem beforeCounterNotTaken_pc (s : NativeState) : (beforeCounterNotTaken s).regs._PC = Sail.BitVec.extractLsb (Sail.BitVec.addInt s.regs._PC 4) 63 0 := rfl

