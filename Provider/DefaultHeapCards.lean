/-- Claim card for `ReleaseProfile.DefaultHeapTrap.ct_2`: its statement with every hypothesis typed by kind and registry id. -/
theorem card_ct_2
    (real : Type)
    [Sail.SailReal real]
    {domain : QueryDomain}
    (spec : TopologyImageSpec domain)
    (config : AttributeConfig)
    (rows : List PermissionRow)
    (mapping : BitVec 64 → Option Nat)
