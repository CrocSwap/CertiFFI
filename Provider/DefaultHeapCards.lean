/-- Claim card for `ReleaseProfile.DefaultHeapTrap.ct_5`: its statement with every hypothesis typed by kind and registry id. -/
theorem card_ct_5
    (real : Type)
    [Sail.SailReal real]
    {domain : QueryDomain}
    (spec : TopologyImageSpec domain)
    (config : AttributeConfig)
    (rows : List PermissionRow)
    (mapping : BitVec 64 → Option Nat)
    (pins : HeapV2E17.Pins)
    (scope : Nat → Prop)
    (image : MemReloc.Image)
    (loadBase : MemReloc.Word)
    (base : BitVec 64)
    (offS : Nat → BitVec 64)
    (budget : Nat)
    (catalogue : ControlCatalogue)
    (e1 : NativeState)
    (e2 : NativeState)
    (room : CertiFFI.Claim.RunCheck "card:budget" ((357 + 12) ≤ budget))
    (aligned : CertiFFI.Claim.RunCheck "card:plan-offsets" (∀ j, (offS j).toNat % 4 = 0))
