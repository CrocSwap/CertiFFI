theorem action_prefixV (real : Type) [Sail.SailReal real]
    (source fetched : NativeState) (enc0 : __InstrEnc)
    (Rd : BitVec 5)
    (Rn : BitVec 5) (rd : Rd.toNat < 31) (rn : Rn.toNat < 31)
    (pins : StepPins fetched)
    (input : NativeEntryInput.Input source fetched)
    (guard : MetadataGuard fetched) (ticks : Nat) (quiet : HookQuiet ticks fetched) :
    ∃ sp fin,
      (PMUEvent PMU_EVENT_INST_SPEC : SailM Unit) fetched = .ok () sp ∧
      NativeEntryInput.Input source (actionState (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9) ∧
      (actionState (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9).mem = fetched.mem ∧
      (actionState (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9).events = fetched.events ∧
      nativeTail real source (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) enc0 fetched =
        nativeAfterAction real source (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) enc0 fin ∧
      fin.regs.BTypeNext = (actionState (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9).regs.BTypeNext ∧
      NativeEntryContract.Frame NativeEntryBodyFlag.Sbcs64.writes
        (actionState (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9) fin ∧
      HookQuiet ticks fin ∧ fin.mem = fetched.mem ∧
      fin.events = fetched.events ∧
      ∃ v : BitVec 64, fin.regs.gpr = (actionState (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9).regs.gpr.set (GPRSummary.key Rd.toNat).val v (GPRSummary.key Rd.toNat).isLt ∧ fin.regs.SP_EL0 = (actionState (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9).regs.SP_EL0 ∧
      fin = ArmBridge.CruxCore.resSt (actionState (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9) ((decode_sbcs_aarch64_instrs_integer_arithmetic_add_sub_carry Rd Rn 31#5 1#1 1#1 1#1 : SailM Unit) (actionState (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9)) := by
  obtain ⟨sp, hook, post⟩ := Owner.spec_rule ticks fetched quiet
  have currentGuard := guard.after_E20 post.frame
  have el : fetched.regs.PSTATE.EL = 0#2 := by
    rw [← input.ps]
    exact input.el0
  have currentInput := input.trans (NativeEntryInput.of_E20 fetched sp post.frame el)
  have metadataInput := currentInput.after_metadata (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) 9
  have metadataQuiet := actionState_quiet (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9 ticks post.quiet
  have metaPins := entryPins_at_metadata sp (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) 9
    (NativeEntryTail.EntryPins.after_E20 fetched sp (NativeEntryTail.EntryPins.of_scalar fetched pins) post.frame)
  have classGuard : NativeEntryBodyFlag.Sbcs64.Guard (actionState (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9) Rd Rn := by
    constructor <;> first | assumption | exact metaPins.el | exact metaPins.nrw | exact metaPins.f4 | exact metaPins.spe | (show sp.regs.PSTATE.BTYPE = 0#2; rw [(PMUFrame.of_E20 post.frame).pstate]; exact pins.btype) | (show sp.regs.BTypeNext = 0#2; exact (PMUFrame.of_E20 post.frame).btn.trans pins.btn)
  obtain ⟨fin, action, memRun, eventsRun, actFrame, _, frame, finalQuiet⟩ :=
    NativeEntryBodyFlag.Sbcs64.run (actionState (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9) Rd Rn classGuard ticks metadataQuiet
  obtain ⟨v2, hg2, hs2⟩ := HeapV2StepCerts.SbcsKeySail.regs_sail (actionState (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9) fin Rd Rn classGuard.rd classGuard.rn classGuard.el classGuard.a64 classGuard.aa64 classGuard.btype classGuard.btn action
  have dispatch : DispatchAt real (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn)
      (decode_sbcs_aarch64_instrs_integer_arithmetic_add_sub_carry Rd Rn 31#5 1#1 1#1 1#1) 9 := by
    intro pc t see
    exact NativeEntryBodyDispatch.Sbcs64.dispatch_at real pc Rd Rn t (by simpa using see)
  have boundary := metadata_boundary_at real source (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn)
    (decode_sbcs_aarch64_instrs_integer_arithmetic_add_sub_carry Rd Rn 31#5 1#1 1#1 1#1) enc0 sp currentGuard 9 (by decide) dispatch
  have memory : fin.mem = (actionState (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9).mem := by
    exact memRun
  have events : fin.events = (actionState (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9).events := by
    exact eventsRun
  have eventFrame : fin.events = fetched.events := by
    simpa only [actionState_events, post.events] using events
  refine ⟨sp, fin, hook, metadataInput,
    (actionState_mem (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9).trans post.mem,
    (actionState_events (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9).trans post.events,
    ?_, actFrame.btn, frame, finalQuiet,
    memory.trans ((actionState_mem (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9).trans post.mem), eventFrame, v2, hg2, hs2, by rw [action]; rfl⟩
  calc
    nativeTail real source (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) enc0 fetched =
        afterSpecPmu real source (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) enc0 sp :=
      spec_pmu_boundary real source (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) enc0 fetched sp hook
    _ = nativeAtAction real source (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn)
        (decode_sbcs_aarch64_instrs_integer_arithmetic_add_sub_carry Rd Rn 31#5 1#1 1#1 1#1) enc0
        (actionState (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9) := boundary
    _ = nativeAfterAction real source (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) enc0 fin :=
      action_boundary real source (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn)
        (decode_sbcs_aarch64_instrs_integer_arithmetic_add_sub_carry Rd Rn 31#5 1#1 1#1 1#1) enc0
        (actionState (NativeEntryBodyDispatch.Sbcs64.selected Rd Rn) sp 9) fin action


