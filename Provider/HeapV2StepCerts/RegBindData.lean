def binds (k : Nat) : List Bind := bindsTable.getD k []
def upds (k : Nat) : List (Reg × Upd) := updsTable.getD k []

theorem table_length : bindsTable.length = 359 ∧ updsTable.length = 358 := by decide +kernel

/-- One step of the binding table is derivable from the previous one. -/
def stepOK (k : Nat) : Bool := (binds (k + 1)).all (Derives (upds k) (binds k))

theorem table_ok_0 : ∀ i < 40, stepOK (0 + i) = true := by decide +kernel
theorem table_ok_1 : ∀ i < 40, stepOK (40 + i) = true := by decide +kernel
theorem table_ok_2 : ∀ i < 40, stepOK (80 + i) = true := by decide +kernel
theorem table_ok_3 : ∀ i < 40, stepOK (120 + i) = true := by decide +kernel
theorem table_ok_4 : ∀ i < 40, stepOK (160 + i) = true := by decide +kernel
theorem table_ok_5 : ∀ i < 40, stepOK (200 + i) = true := by decide +kernel
theorem table_ok_6 : ∀ i < 40, stepOK (240 + i) = true := by decide +kernel
theorem table_ok_7 : ∀ i < 40, stepOK (280 + i) = true := by decide +kernel
theorem table_ok_8 : ∀ i < 38, stepOK (320 + i) = true := by decide +kernel

theorem table_ok (k : Nat) (hk : k < 358) : (binds (k + 1)).all (Derives (upds k) (binds k)) = true := by
  show stepOK k = true
  if h0 : k < 40 then have e := table_ok_0 (k - 0) (by omega); rwa [show 0 + (k - 0) = k by omega] at e
  else if h1 : k < 80 then have e := table_ok_1 (k - 40) (by omega); rwa [show 40 + (k - 40) = k by omega] at e
  else if h2 : k < 120 then have e := table_ok_2 (k - 80) (by omega); rwa [show 80 + (k - 80) = k by omega] at e
  else if h3 : k < 160 then have e := table_ok_3 (k - 120) (by omega); rwa [show 120 + (k - 120) = k by omega] at e
  else if h4 : k < 200 then have e := table_ok_4 (k - 160) (by omega); rwa [show 160 + (k - 160) = k by omega] at e
  else if h5 : k < 240 then have e := table_ok_5 (k - 200) (by omega); rwa [show 200 + (k - 200) = k by omega] at e
  else if h6 : k < 280 then have e := table_ok_6 (k - 240) (by omega); rwa [show 240 + (k - 240) = k by omega] at e
  else if h7 : k < 320 then have e := table_ok_7 (k - 280) (by omega); rwa [show 280 + (k - 280) = k by omega] at e
  else if h8 : k < 358 then have e := table_ok_8 (k - 320) (by omega); rwa [show 320 + (k - 320) = k by omega] at e
  else omega

theorem binds_zero : binds 0 = [(.sp, 0, 0), (.x 0, 1, 0), (.x 1, 2, 0)] := by decide

