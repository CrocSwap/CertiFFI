/-- Forgetting nothing: a MemTailVAt is a MemTailVPAt with the trivial payload. -/
theorem MemTailVAt.toVP {real : Type} [Sail.SailReal real] {domain : QueryDomain} {spec : TopologyImageSpec domain}
    {config : AttributeConfig} {rows : List PermissionRow} {Ctx : NativeState → Prop} {D : Nat → Prop}
    {w : BitVec 32} {writes : NativeEntry.Effects.Writes} {K : Int} {source : NativeState} {next : BitVec 64}
    {us : List (RegBind.Reg × RegBind.Upd)}
    (h : MemTailVAt real spec config rows Ctx D w writes K source next us) :
    RtSaved.MemFacts.MemTailVPAt real spec config rows Ctx D w writes K source next us (fun _ _ => True) := by
  intro fetched enc0 budget pins input guard quiet it ss current ctx
  obtain ⟨sp, a, fin, written, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14⟩ :=
    h fetched enc0 budget pins input guard quiet it ss current ctx
  exact ⟨sp, a, fin, written, h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12, h13, h14, trivial⟩

/-- The memory R: register effect, value effect (none for memory steps), write frame within D, payload, and
the SCR_EL3 frame last. -/
def MemR (k : Nat) (D : Nat → Prop) (Pay : NativeState → NativeState → Prop) (s f : NativeState) : Prop :=
  RegBind.Holds (RegBind.upds k) s f ∧ ValBind.VEff k s f ∧
    (∃ written : Nat → Prop, WritesOnly written (fun y => s.mem[y]?) (fun y => f.mem[y]?) ∧ ∀ y, written y → D y) ∧
    Pay s f ∧ ArmBridge.CruxGenGuarded.ChainInvV4.GcsFrame s f

theorem codeD_mono {scope : Nat → Prop} {base : MemReloc.Word} {mapping : MemReloc.Mapping}
    {D D' : Nat → Prop} (sub : ∀ y, D' y → D y) (h : ImageTableSeparated scope base mapping D) :
    ImageTableSeparated scope base mapping D' :=
  fun off pa hs hm hd => h off pa hs hm (sub pa hd)

/-- A store's own bytes are plan data bytes. -/
theorem accPA_sub {p : HeapV2E17.Pins} {mapping : BitVec 64 → Option Nat} {e : Nat × Nat × Int × Nat × Bool}
    (member : e ∈ HeapV2Plan.symbolicAccesses) : ∀ y, RtSaved.accPA p mapping e y → dataBytes p mapping y := by
  intro y h
  rcases h with ⟨n, hn, h1, h2⟩ | ⟨hs, n, hn, h1, h2⟩
  · exact ⟨e, member, _, n, Or.inl rfl, hn, h1, h2⟩
  · exact ⟨e, member, _, n, Or.inr rfl, hn, h1, by omega⟩

