theorem hsteps (real : Type) [Sail.SailReal real] {domain : QueryDomain} (spec : TopologyImageSpec domain)
    (config : AttributeConfig) (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat) (base : BitVec 64)
    (pins : HeapV2E17.Pins) (entry : NativeState) (budget : Nat)
    (dp : DeploymentPremises spec config rows mapping base pins entry budget) (hb : 357 ≤ budget)
    (dbl : ArmCertValue.HeapV2Mem.DataBytesLinear pins mapping) (inj : ArmCertValue.HeapV2Mem.RegionsInjective pins mapping)
    (missing : ∀ k, k ∈ missingSteps → ∀ h : k < plan.length,
      StepFact real (I4 spec config rows mapping base pins entry budget) mapping (HeapV2E17.pin pins) regions plan k h) :
    ∀ k (h : k < plan.length), StepFact real (I4 spec config rows mapping base pins entry budget) mapping (HeapV2E17.pin pins) regions plan k h := by
  intro k h
  have hl : k < 357 := by rw [plan_length] at h; exact h
  by_cases c0 : k < 30
  · exact hsteps_000 real spec config rows mapping base pins entry budget dp hb dbl inj missing k (by omega) (by omega) h
  by_cases c1 : k < 60
  · exact hsteps_030 real spec config rows mapping base pins entry budget dp hb dbl inj missing k (by omega) (by omega) h
