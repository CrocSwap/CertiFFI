      SlotKeep p mapping (stateAt real e 7) (stateAt real e j))
    (h365 : ∃ fin, modelStep real (stateAt real e (L + 8)) = .ok () fin ∧
      fin.regs.PSTATE.DIT = (stateAt real e (L + 8)).regs.PSTATE.DIT ∧
      ∀ d : BitVec 128, SlotHas p mapping d (stateAt real e (L + 8)) → fin.regs.gpr[9] = ArmCertMem.LdpEval.ldpLo d)
    (h366 : ∃ fin, modelStep real (stateAt real e (L + 9)) = .ok () fin ∧
      fin.regs.PSTATE.DIT = (stateAt real e (L + 9)).regs.PSTATE.DIT ∧ fin.regs.gpr[9] = (stateAt real e (L + 9)).regs.gpr[9])
    (h367 : ∃ fin, modelStep real (stateAt real e (L + 10)) = .ok () fin ∧
      fin.regs.PSTATE.DIT = (stateAt real e (L + 10)).regs.gpr[9].extractLsb 24 24)
    (h368 : ∃ fin, modelStep real (stateAt real e (L + 11)) = .ok () fin ∧
