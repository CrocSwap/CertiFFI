theorem shim_chainG (real : Type) [Sail.SailReal real] (L : Nat)
    {domain : QueryDomain} (spec : TopologyImageSpec domain)
    (config : AttributeConfig) (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat)
    (pins : HeapV2E17.Pins)
    (scope : Nat → Prop) (image : MemReloc.Image) (loadBase : MemReloc.Word)
    (separated : ImageTableSeparated scope loadBase mapping (rowsFootprint spec.imageRows).byte)
    (codeSlot : ImageTableSeparated scope loadBase mapping (RtShim2.ShimMem.slotBytes pins mapping))
    (Store : Nat → Prop) (codeStore : ImageTableSeparated scope loadBase mapping Store)
    (base : BitVec 64) (offS : Nat → BitVec 64) (budget : Nat) (e : NativeState) (callerPC : BitVec 64)
    (agrees : ConsumerMapAgrees spec mapping (shimMap spec mapping base pins))
    (room : (L + 12) ≤ budget) (page : base.toNat % 4096 = 0) (aligned : ∀ j, (offS j).toNat % 4 = 0)
    (offPre : ∀ j, j ≤ 6 → offS j = shimPC j) (offPost : ∀ j, (L + 8) ≤ j → j ≤ (L + 11) → offS j = shimPC (j - (L + 1)))
    (inv0 : RtShim2.ShimInv spec config rows mapping (shimMap spec mapping base pins)
      scope image loadBase base offS budget 0 e)
    (callerX30 : e.regs.gpr[30] = callerPC + 4#64)
    (slotE : RtShim.SlotPrem.ShimSlotPresent pins mapping e)
    (spE : e.regs.SP_EL0 = BitVec.ofNat 64 pins.sp + BitVec.ofInt 64 16)
    (static : RtShim.SlotPrem.ShimSlotStatic pins mapping (rowsFootprint spec.imageRows))
    (spAligned : (BitVec.ofNat 64 pins.sp).toNat % 16 = 0)
    (sep : ∀ a, RtShim2.ShimMem.slotBytes pins mapping a → ¬ Store a)
    (ob0 : FetchObligations spec config rows mapping NativeEntryDispatch.BtiC.word (stateAt real e 0))
    {w1 : BitVec 32} {writes1 : NativeEntry.Effects.Writes} {K1 : Int} {us1 : List (RegBind.Reg × RegBind.Upd)}
    (tail1 : RegValE.ClassTailVAt real w1 writes1 K1 (stateAt real e 1) ((stateAt real e 1).regs._PC + 4#64) us1)
    (hw1 : writes1.dit = false) (sub1 : RegBind.updOf us1 .sp = .set .sp (-16))
    (keep1all : ∀ i : Fin 31, RegBind.updOf us1 (.x i) = .keep)
    (ob1 : FetchObligations spec config rows mapping w1 (stateAt real e 1))
    (prof2 : NativeEntryAdapters.MrsDit.Profile (stateAt real e 2))
    (ob2 : FetchObligations spec config rows mapping (NativeEntryDispatch.MrsDit.word 9#5) (stateAt real e 2))
    (ob3 : FetchObligations spec config rows mapping (NativeEntryBodyDispatch.Stp.selected 9#5 30#5 0#7)
      (stateAt real e 3))
    (prof4 : NativeEntryAdapters.DitOn.Profile (stateAt real e 4))
    (ob4 : FetchObligations spec config rows mapping NativeEntryDispatch.DitOn.word (stateAt real e 4))
    (prof5 : NativeEntryAdapters.IsbSy.Profile (stateAt real e 5))
    (ob5 : FetchObligations spec config rows mapping NativeEntryDispatch.IsbSy.word (stateAt real e 5))
    (imm26 : BitVec 26) (controls6 : CallerControls (stateAt real e 6))
    (bl7 : blTarget imm26 (stateAt real e 6) = base + offS 7)
    (low6 : (base + offS 7).toNat < 2 ^ 55)
    (ob6 : FetchObligations spec config rows mapping (NativeEntryCallerDispatch.Bl.word imm26) (stateAt real e 6))
    (bm : ArmCert.Premises.TranslationAgreesV1.ConsumerMap) (bscope : Nat → Prop) (bimage : MemReloc.Image)
    (bloadBase : MemReloc.Word) (bodyOff : Nat → BitVec 64) (bodyBudget : Nat) (calleeSaved : List (Fin 31))
    (C : RtShimG.BodyContract real spec config rows mapping bm bscope bimage bloadBase base bodyOff bodyBudget L Store
      calleeSaved (stateAt real e 7))
    (hbudget : budget - (L + 8) = bodyBudget - (L + 1))
    (low365 : (base + offS (L + 8)).toNat < 2 ^ 55)
    (closed365 : ClosedMembershipAt spec config rows mapping (shimMap spec mapping base pins)
      (ArmBridge.CruxGenGuarded.beforeFetchState (stateAt real e (L + 8))))
    (pre : ShimPreG real L spec config rows mapping pins scope image loadBase base offS budget e)
    (ob365 : FetchObligations spec config rows mapping (NativeEntryBodyDispatch.Ldp.selected 9#5 30#5 0#7)
      (stateAt real e (L + 8)))
    {w8 : BitVec 32} {writes8 : NativeEntry.Effects.Writes} {K8 : Int} {us8 : List (RegBind.Reg × RegBind.Upd)}
    (tail8 : RegValE.ClassTailVAt real w8 writes8 K8 (stateAt real e (L + 9)) ((stateAt real e (L + 9)).regs._PC + 4#64) us8)
    (hw8 : writes8.dit = false) (add8 : RegBind.updOf us8 .sp = .set .sp 16)
    (keep8all : ∀ i : Fin 31, RegBind.updOf us8 (.x i) = .keep)
    (ob8 : FetchObligations spec config rows mapping w8 (stateAt real e (L + 9)))
    (prof9 : NativeEntryAdapters.MsrDit.Profile (stateAt real e (L + 10)))
    (ob9 : FetchObligations spec config rows mapping (NativeEntryDispatch.MsrDit.word 9#5) (stateAt real e (L + 10)))
    (low10 : (callerPC + 4#64).toNat < 2 ^ 55)
    (ob10 : FetchObligations spec config rows mapping (EntryBodyRet.W 30#5) (stateAt real e (L + 11))) :
    ShimChainMG real L spec config rows mapping pins scope image loadBase base offS budget e callerPC := by
  have I : ∀ j, (j ≤ 6 ∨ ((L + 8) ≤ j ∧ j ≤ (L + 11))) → j < budget := fun j h => by omega
  have straight : ∀ j, ((L + 8) ≤ j ∧ j ≤ (L + 10)) → offS (j + 1) = offS j + 4#64 := by
    intro j ⟨a, b⟩
    rw [offPost (j + 1) (by omega) (by omega), offPost j a (by omega),
      show j + 1 - (L + 1) = (j - (L + 1)) + 1 by omega, shimPC_succ]
  have i7 := pre.inv7
  have link := pre.x30_7
  have x30_3 := pre.x30_3
  have sp3 := pre.sp3
  have slot4 := pre.slot4
  -- the body and its RET to s7
  have x30 : (stateAt real (stateAt real e 7) L).regs.gpr[(GPRSummary.key (30#5).toNat).val] = base + offS (L + 8) :=
    C.x30.trans link
  have bodyMem : ∀ a, ¬ Store a →
      (stateAt real (stateAt real e 7) L).mem[a]? = (stateAt real e 7).mem[a]? := C.memFrame L (Nat.le_refl L)
  have sp7 := pre.sp7
  have sp364 : (stateAt real (stateAt real e 7) L).regs.SP_EL0 = BitVec.ofNat 64 pins.sp :=
    C.sp.trans sp7
  have s364 : stateAt real e (L + 7) = stateAt real (stateAt real e 7) L := by
    rw [show L + 7 = 7 + L by omega]; exact stateAt_add real e 7 L
  have J364 := C.invRet
  have fetch357 := Classical.choice C.fetchRet
  obtain ⟨f, r364, i365, gR, spR, mR, _⟩ := RtShim2.ShimBranch.plan_shim_ret real spec config rows mapping _ _ _ _
    C.sepRet base bodyOff bodyBudget L C.budgetRet C.pageRet C.alignRet 30#5
    (by decide) (by decide) _ J364 (by rw [x30]; exact low365) offS budget (L + 8) hbudget x30 fetch357
  have e365 : stateAt real e (L + 8) = f := by
    rw [show ((L + 8) : Nat) = 7 + (L + 1) by omega, stateAt_add real e 7 (L + 1)]; exact stateAt_succ_of r364
  rw [← e365] at i365 spR mR gR
  rw [← s364] at r364
  have placed365 : MemReloc.ImageOn scope image (stateAt real e (L + 8)) loadBase mapping :=
    HeapV2StepCerts.placed_class mR (HeapV2StepCerts.placed_class_writes bodyMem codeStore i7.v2.placed)
  have J365 : RtShim2.ShimInv spec config rows mapping (shimMap spec mapping base pins)
      scope image loadBase base offS budget (L + 8) (stateAt real e (L + 8)) :=
    { v2 := ⟨i365.v2.v1, closed365, placed365, i365.v2.branch⟩, raw := i365.raw, noUpd := i365.noUpd,
      post2 := i365.post2, mode := i365.mode, debug := i365.debug, feat := i365.feat, dcache := i365.dcache }
  have sp365 : (stateAt real e (L + 8)).regs.SP_EL0 = BitVec.ofNat 64 pins.sp := by rw [spR, ← s364]; exact s364 ▸ sp364
  -- the slot from s3's STP to s7
  have keepBody : ∀ n, mapping (BitVec.ofNat 64 pins.sp) = some n → ∀ i < 16,
      (stateAt real e (L + 8)).mem[n + i]? = (stateAt real e 4).mem[n + i]? := by
    intro n hn i hi
    rw [mR]
    refine (bodyMem (n + i) (sep _ ⟨n, hn, by omega, by omega⟩)).trans ?_
    exact pre.mem47 _
  have slot365 : SlotHas pins mapping (ArmCertMem.StpEval.stpData (stateAt real e 3) 9#5 30#5) (stateAt real e (L + 8)) :=
    fun n hn i hi => (keepBody n hn i hi).trans (slot4 n hn i hi)
  have present365 : RtShim.SlotPrem.ShimSlotPresent pins mapping (stateAt real e (L + 8)) := fun n hn i hi => by
    rw [slot365 n hn i hi]; rfl
  -- epilogue chain
  have x30_366 := ev_succ (shim_ldp_hi real spec config rows mapping scope image loadBase base offS budget (L + 8)
    (I (L + 8) (by omega)) page (aligned (L + 8)) _ J365 static sp365 spAligned present365 ob365)
  obtain ⟨f, r365, i366, h366, ⟨wr5, wo5, _, in5⟩, _, _⟩ := ArmCertShim.ShimMemD.plan_shim_memD real spec config rows mapping _ pins scope
    image loadBase separated base offS budget (L + 8) (I (L + 8) (by omega)) page (aligned (L + 8)) _ (fun _ _ _ _ h => h) _ _ _ _
    (fun x => x.regs._PC + 4#64) _ J365 present365 sp365
    (ArmCertShim.ShimMemD.memS_Ldp0 real spec config rows mapping static spAligned 9#5 30#5 (by decide) (by decide)
      (by decide) (by decide +kernel) _) (next_placed J365.v2.v1.pc (straight (L + 8) ⟨by omega, by omega⟩)) ob365
  have e366 : stateAt real e (L + 9) = f := stateAt_succ_of r365
  rw [← e366] at i366 h366 r365 wo5
  obtain ⟨f, r366, i367, h367, m367, _⟩ := RtShim2.plan_shim_class real spec config rows mapping _ scope image loadBase
    separated base offS budget (L + 9) (I (L + 9) (by omega)) page (aligned (L + 9)) _ _ _ _ (fun x => x.regs._PC + 4#64) _
    i366 (classE_toV tail8) (next_placed i366.v2.v1.pc (straight (L + 9) ⟨by omega, by omega⟩)) ob8
  have e367 : stateAt real e (L + 10) = f := stateAt_succ_of r366
  rw [← e367] at i367 h367 r366 m367
  obtain ⟨f, r367, i368, h368, m368, _⟩ := RtShim2.plan_shim_class real spec config rows mapping _ scope image loadBase
    separated base offS budget (L + 10) (I (L + 10) (by omega)) page (aligned (L + 10)) _ _ _ _ (fun x => x.regs._PC + 4#64) _
    i367 (NativeShimTails.msrDit9_tailVAt real _ prof9) (next_placed i367.v2.v1.pc (straight (L + 10) ⟨by omega, by omega⟩)) ob9
  have e368 : stateAt real e (L + 11) = f := stateAt_succ_of r367
  rw [← e368] at i368 h368 r367 m368
  have x30_368 : (stateAt real e (L + 11)).regs.gpr[30] = callerPC + 4#64 := by
    rw [RtSaved.kept_reg h368 ⟨30, by decide⟩ rfl, RtSaved.kept_reg h367 ⟨30, by decide⟩ (keep8all _),
      x30_366 _ slot365, ldpHi_stpData, x30_3, callerX30]
  have tgt : (stateAt real e (L + 11)).regs.gpr[(GPRSummary.key (30#5).toNat).val] =
      base + (fun _ => callerPC + 4#64 - base) (L + 12) := by
    show (stateAt real e (L + 11)).regs.gpr[30] = _
    rw [x30_368]
    apply BitVec.eq_of_toNat_eq
    simp only [BitVec.toNat_add, BitVec.toNat_sub]
    omega
  obtain ⟨f, r368, i369, g369, sp369, m369, _⟩ := RtShim2.ShimBranch.plan_shim_ret real spec config rows mapping _
    scope image loadBase separated base offS budget (L + 11) (I (L + 11) (by omega)) page (aligned (L + 11)) 30#5 (by decide)
    (by decide) _ i368
    (by show ((stateAt real e (L + 11)).regs.gpr[30]).toNat < _; rw [x30_368]; exact low10) (fun _ => callerPC + 4#64 - base) budget (L + 12) rfl tgt ob10
  have e369 : stateAt real e (L + 12) = f := stateAt_succ_of r368
  rw [← e369] at i369 g369 sp369 r368 m369
  have memPost : ∀ a : Nat, (stateAt real e (L + 12)).mem[a]? = (stateAt real e (L + 7)).mem[a]? := by
    intro a
    have w5 := wo5 a (fun w => in5 a w); simp only at w5
    rw [m369, m368, m367, w5, mR, s364]
  -- SP through the epilogue
  have sp366 : (stateAt real e (L + 9)).regs.SP_EL0 = (stateAt real e (L + 8)).regs.SP_EL0 := h366 .sp
  have sp367 : (stateAt real e (L + 10)).regs.SP_EL0 = (stateAt real e (L + 9)).regs.SP_EL0 + BitVec.ofInt 64 16 := by
    have h := h367 .sp; rw [add8] at h; exact h
  have sp369' : (stateAt real e (L + 12)).regs.SP_EL0 = e.regs.SP_EL0 := by
    have k368 : (stateAt real e (L + 11)).regs.SP_EL0 = (stateAt real e (L + 10)).regs.SP_EL0 := h368 .sp
    rw [sp369, k368, sp367, sp366, sp365, spE]
  -- the DIT window (body facts: dit_body_mem / dit_body_ret for DIT, the residue's StoreBytes frame for the slot)
  have hbody : ∀ j, 7 ≤ j → j ≤ (L + 8) → (stateAt real e j).regs.PSTATE.DIT = (stateAt real e 7).regs.PSTATE.DIT ∧
      SlotKeep pins mapping (stateAt real e 7) (stateAt real e j) := by
    intro j lo hi
    obtain ⟨k, rfl⟩ : ∃ k, j = 7 + k := ⟨j - 7, by omega⟩
    rcases Nat.lt_or_ge k (L + 1) with h | h
    · rw [stateAt_add real e 7 k]
      refine ⟨C.dit k (by omega), fun n hn i hi => ?_⟩
      exact C.memFrame k (by omega) (n + i) (sep _ ⟨n, hn, by omega, by omega⟩)
    · obtain rfl : k = (L + 1) := by omega
      refine ⟨?_, fun n hn i hi => ?_⟩
      · rw [stateAt_add real e 7 (L + 1)]
        exact C.ditRet (by rw [x30]; exact low365)
      · rw [show 7 + (L + 1) = L + 8 by omega]
        rw [mR]
        exact bodyMem (n + i) (sep _ ⟨n, hn, by omega, by omega⟩)
  have invAll : ∀ j, (j ≤ 6 ∨ ((L + 8) ≤ j ∧ j ≤ (L + 11))) →
      RtShim2.ShimInv spec config rows mapping (shimMap spec mapping base pins)
        scope image loadBase base offS budget j (stateAt real e j) := by
    intro j hj
    by_cases h6 : j ≤ 6
    · exact pre.inv j h6
    rcases (show j = (L + 8) ∨ j = (L + 9) ∨ j = (L + 10) ∨ j = (L + 11) by omega) with rfl | rfl | rfl | rfl
    · exact J365
    · exact i366
    · exact i367
    · exact i368
  have win := dit_window_shimG real L spec config rows mapping scope image loadBase base offS budget e room page aligned
    invAll ob0 (classE_toV tail1) hw1 ob1 prof2 ob2 static spAligned sp3 ob3 prof4 ob4 prof5 ob5 imm26 controls6
    (by rw [bl7]; exact low6) ob6 hbody sp365 present365 ob365 (classE_toV tail8) hw8 (keep8all _) ob8 prof9 ob9
    (by decide +kernel) (by show ((stateAt real e (L + 11)).regs.gpr[30]).toNat < _; rw [x30_368]; exact low10) ob10
  have kLdp : ∀ i : Fin 31, i.val ≠ 9 → i.val ≠ 30 → RegBind.updOf (RegBind.updLdp 9#5 30#5) (.x i) = .keep := by
    decide
  refine { toShimChainG := ?_, memPost := memPost }
  refine
    { runs := fun j hj => ?_, inv := invAll, inv369 := i369, sp3 := sp3, sp365 := sp365, present365 := present365,
      ditOn := win.1, ditRestored := win.2, x30_364 := s364 ▸ x30, x30_368 := x30_368, sp369 := sp369',
      x30_369 := ?_, keepPre := pre.keepPre, keepPost := ?_ }
  · rcases (show j = 0 ∨ j = 1 ∨ j = 2 ∨ j = 3 ∨ j = 4 ∨ j = 5 ∨ j = 6 ∨ j = (L + 7) ∨ j = (L + 8) ∨ j = (L + 9) ∨ j = (L + 10) ∨
      j = (L + 11) by omega) with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact pre.runs 0 (by omega)
    · exact pre.runs 1 (by omega)
    · exact pre.runs 2 (by omega)
    · exact pre.runs 3 (by omega)
    · exact pre.runs 4 (by omega)
    · exact pre.runs 5 (by omega)
    · exact pre.runs 6 (by omega)
    · rw [← e365] at r364; exact r364
    · exact r365
    · exact r366
    · exact r367
    · exact r368
  · show (stateAt real e (L + 12)).regs.gpr[30] = _
    rw [g369, x30_368, callerX30]
  · intro i n9 n30
    rw [g369, RtSaved.kept_reg h368 i rfl, RtSaved.kept_reg h367 i (keep8all i), RtSaved.kept_reg h366 i (kLdp i n9 n30),
      gR, s364]

