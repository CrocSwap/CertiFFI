by shim_chainG, consumed by the ShimPrologue / ShimEpilogueG halves and by ShimKeepG. -/
structure ShimChainG (real : Type) [Sail.SailReal real] (L : Nat) {domain : QueryDomain} (spec : TopologyImageSpec domain)
    (config : AttributeConfig) (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat) (pins : HeapV2E17.Pins)
    (scope : Nat → Prop) (image : MemReloc.Image) (loadBase : MemReloc.Word)
    (base : BitVec 64) (offS : Nat → BitVec 64) (budget : Nat) (e : NativeState) (callerPC : BitVec 64) : Prop where
  runs : ∀ j, (j ≤ 6 ∨ ((L + 7) ≤ j ∧ j ≤ (L + 11))) → modelStep real (stateAt real e j) = .ok () (stateAt real e (j + 1))
  inv : ∀ j, (j ≤ 6 ∨ ((L + 8) ≤ j ∧ j ≤ (L + 11))) → RtShim2.ShimInv spec config rows mapping (shimMap spec mapping base pins)
    scope image loadBase base offS budget j (stateAt real e j)
  inv369 : RtShim2.ShimInv spec config rows mapping (shimMap spec mapping base pins) scope image loadBase base
    (fun _ => callerPC + 4#64 - base) budget (L + 12) (stateAt real e (L + 12))
  sp3 : (stateAt real e 3).regs.SP_EL0 = BitVec.ofNat 64 pins.sp
  sp365 : (stateAt real e (L + 8)).regs.SP_EL0 = BitVec.ofNat 64 pins.sp
  present365 : RtShim.SlotPrem.ShimSlotPresent pins mapping (stateAt real e (L + 8))
  ditOn : ∀ j, 5 ≤ j → j ≤ (L + 10) → (stateAt real e j).regs.PSTATE.DIT = 1#1
  ditRestored : (stateAt real e (L + 11)).regs.PSTATE.DIT = e.regs.PSTATE.DIT ∧
    (stateAt real e (L + 12)).regs.PSTATE.DIT = e.regs.PSTATE.DIT
  x30_364 : (stateAt real e (L + 7)).regs.gpr[(GPRSummary.key (30#5).toNat).val] = base + offS (L + 8)
  x30_368 : (stateAt real e (L + 11)).regs.gpr[30] = callerPC + 4#64
  sp369 : (stateAt real e (L + 12)).regs.SP_EL0 = e.regs.SP_EL0
  x30_369 : (stateAt real e (L + 12)).regs.gpr[30] = e.regs.gpr[30]
  keepPre : ∀ i : Fin 31, i.val ≠ 9 → i.val ≠ 30 → (stateAt real e 7).regs.gpr[i.val] = e.regs.gpr[i.val]
  keepPost : ∀ i : Fin 31, i.val ≠ 9 → i.val ≠ 30 →
    (stateAt real e (L + 12)).regs.gpr[i.val] = (stateAt real e (L + 7)).regs.gpr[i.val]

/-- ShimChainG + Memory's epilogue memory frame (ShimFrameV memPost): σ(12+L) equals σ(7+L) everywhere. -/
structure ShimChainMG (real : Type) [Sail.SailReal real] (L : Nat) {domain : QueryDomain} (spec : TopologyImageSpec domain)
    (config : AttributeConfig) (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat) (pins : HeapV2E17.Pins)
    (scope : Nat → Prop) (image : MemReloc.Image) (loadBase : MemReloc.Word)
    (base : BitVec 64) (offS : Nat → BitVec 64) (budget : Nat) (e : NativeState) (callerPC : BitVec 64)
    extends ShimChainG real L spec config rows mapping pins scope image loadBase base offS budget e callerPC : Prop where
  memPost : ∀ a : Nat, (stateAt real e (L + 12)).mem[a]? = (stateAt real e (L + 7)).mem[a]?

