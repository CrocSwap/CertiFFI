/-- Trap-path deployment premises over consumer map `m` at timer budget `budget` (no NormalPath). -/
structure TrapPremises {domain : QueryDomain} (spec : TopologyImageSpec domain) (config : AttributeConfig)
    (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat) (m : ArmCert.Premises.TranslationAgreesV1.ConsumerMap)
    (base : BitVec 64) (pins : HeapV2E17.Pins) (tableRows : NativeSourceInit.Plan) (budget : Nat) (entry : NativeState) : Prop where
  static : HeapV2StepCerts.CodeStatic mapping base (rowsFootprint spec.imageRows).byte
  agrees : ConsumerMapAgrees spec mapping m
  page : base.toNat % 4096 = 0
  low : base.toNat < 2 ^ 54
  regsOK : NativeInit3.EntryRegsOK spec config rows base HeapV2Compose.offsetOf pins entry
  memOK : NativeInit3.EntryMemOK spec rows mapping base tableRows pins entry
  closed : ClosedMembershipAt spec config rows mapping m entry
  quiet : ArmCert.HookQuiet.V0.HookQuiet budget entry

theorem low716 {base : BitVec 64} (low : base.toNat < 2 ^ 54) : (base + RtBl.Trap.trapOffset).toNat < 2 ^ 55 :=
  HeapV2StepCerts.E17General.low_of _ (by decide) low

