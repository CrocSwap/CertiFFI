-- Generated by gen/gen_address_if_total.py; existing E11 and F4, no new premise content.
import ArmCertWalk.ExistingE11Debug
open Sail Sail.ConcurrencyInterfaceV1 ArmFull ArmFull.Functions
open ArmCert.Translate ArmCert.Translate.Model
set_option autoImplicit false
set_option maxHeartbeats 150000
set_option maxRecDepth 512
namespace ArmCertWalk
/-- Complete ACTUAL IFETCH address wrapper, including source debug checks and
both translation events. The actual consumer must bind its EXISTING E11 and
F4 premise fields on the same state; no additional environment premise or
future-success callback is introduced. -/
theorem native_translate_address_if_total {domain : QueryDomain} (spec : TopologyImageSpec domain)
    (config : AttributeConfig) (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat)
    (query : AccessQuery) (member : domain query) (aligned : Bool) (size : Int)
    (leafLevel logical : Nat) (physical : FullAddress) (view : S1DescriptorPIE.View 64)
    (path : S1LogicalReference.Path (logicalObserve spec.logicalRows)
      (effectiveBits spec.physicalConfig).toNat query.va spec.layout.start
      (S1LogicalReference.rootBits spec.layout.start spec.layout.inputBits) spec.layout.root
      (.leaf leafLevel logical physical view))
    (binding : PathPermissionUse spec config rows query path ⟨0#2, false, false⟩)
    (initial : State)
    (lower : AArch64_GetVARange query.va = .VARange_LOWER)
    (current : HostWalkAt config spec.controls spec.physicalConfig initial)
    (mode : HostEL0ModeAt initial.regs)
    (fetch : query.request.raw.acctype = .AccessType_IFETCH)
    (aa64 : initial.regs.FeatureImpl[4] = true)
    (debug : ExistingE11DebugAt initial.regs)
    (bound : HostImageParamsAt initial.regs
      {spec.params with txsz := _get_TCR_EL2_Type_T0SZ (initial.regs.bank_BitVec_64 .TCR_EL2)})
    (geometry : spec.params.txsz = normalizeTxsz initial.regs
      (_get_TCR_EL2_Type_T0SZ (initial.regs.bank_BitVec_64 .TCR_EL2)))
    (layout : CurrentLayoutAt spec.layout spec.params query.va initial.regs)
    (images : CurrentImagesAt spec config rows initial)
    (guard : HostTranslateGuardAt initial.regs spec.params)
    (checked : TranslateQueryChecks initial.regs spec.params query.va query.request.raw)
    (rawFault : sourceTxszFault initial.regs
      {spec.params with txsz := _get_TCR_EL2_Type_T0SZ (initial.regs.bank_BitVec_64 .TCR_EL2)} = false)
    (enabled : currentTranslationEnabled initial.regs = true)
    (accessEL : query.request.raw.el = EL0) (ss : query.request.raw.ss = .SS_NonSecure)
    (cache : initial.regs.bank_Bool .__tlb_enabled = false)
    (epd : currentWalkEPD initial.regs query.va = 0#1)
    (map : LeafMapAt mapping spec.physicalConfig initial.regs query leafLevel view)
    (outputPolicy : OutputCacheAdmissible query.request.raw initial.regs) :
    ∃ address faultOut other,
      AArch64_TranslateAddress query.va query.request.raw aligned size initial = .ok address other ∧
      CleanTranslateResultFields spec config rows mapping query leafLevel view initial (faultOut, address) other := by
  obtain ⟨address, faultOut, ready, residual, completed⟩ := native_translate_address_if_prefix spec config rows mapping
    query member aligned size leafLevel logical physical view path binding initial lower current mode fetch
    bound geometry layout images guard checked rawFault enabled accessEL ss cache epd map outputPolicy
  have saved := completed
  obtain ⟨params, out, operations, active, format, resultFault, faultNone, mapResult, va,
    normal, addressFault, nonsecure, addressPA, registers, history, imagesAfter, held⟩ := completed
  obtain ⟨readyHost, readyMode⟩ := translate_current_host_mode config spec.controls spec.physicalConfig
    query.request.raw (translateCurrent out) initial ready current mode registers
  have readyAA64 : ready.regs.FeatureImpl[4] = true := by
    rw [registers]
    unfold fetchGuardRegs
    split <;> exact aa64
  have readyDebug : ExistingE11DebugAt ready.regs := by
    rw [registers]
    unfold fetchGuardRegs
    split
    · exact debug.guarded_page initial.regs _
    · exact debug
  obtain ⟨debugFault, other, finishCall, debugNone, finishRegs, finishMem⟩ :=
    translation_debug_finish_total query.va query.request.raw size address ready readyHost.regime
      readyMode readyAA64 readyDebug
  let result := {address with fault := debugFault, vaddress := Sail.BitVec.zeroExtend query.va 64}
  refine ⟨result, faultOut, other, ?_, ?_⟩
  · rw [residual]
    exact finishCall
  · have framed := clean_translate_result_memory_frames spec config rows mapping query leafLevel view
      initial initial ready other (faultOut, address) rfl rfl finishRegs finishMem saved
    obtain ⟨params, out, operations, active, format, resultFault, faultNone, mapResult, va,
      normal, addressFault, nonsecure, addressPA, registers, history, imagesAfter, held⟩ := framed
    refine ⟨params, out, operations, active, format, resultFault, faultNone, mapResult, ?_, normal,
      debugNone, nonsecure, addressPA, registers, history, imagesAfter, held⟩
    change Sail.BitVec.zeroExtend query.va 64 = query.va
    simp [Sail.BitVec.zeroExtend]

#print axioms native_translate_address_if_total
end ArmCertWalk
