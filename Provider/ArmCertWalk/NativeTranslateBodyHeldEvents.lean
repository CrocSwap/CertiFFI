/-- Actual conditional leaf swap events at leaf slot `pa`. -/
def LeafSwapTraffic (pa : Nat) (updated : Bool) (delta : Array Event) : Prop :=
  (updated = false ∧ delta = #[]) ∨
  (updated = true ∧ ∃ (updAcc : AccessDescriptor) (slot : AddressDescriptor) (ee : BitVec 1) (word : BitVec 64),
    updAcc.acctype = .AccessType_TTW ∧ slot.paddress.address.toNat = pa ∧
    delta = #[swapReadEvent updAcc slot, swapWriteEvent ee word updAcc slot])

/-- Ordered actual translation-walk traffic: walk steps, then the leaf swap. -/
def TranslateTrafficFrom (before : Array Event) (walk : List (Nat × Bool × Array Event))
    (leaf : Nat × Bool × Array Event) (after : Array Event) : Prop :=
  ∃ middle, WalkTrafficFrom before walk middle ∧ LeafSwapTraffic leaf.1 leaf.2.1 leaf.2.2 ∧
    after = middle ++ leaf.2.2

