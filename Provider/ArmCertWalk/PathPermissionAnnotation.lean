/-- Declarative annotation of the existing topology proof. Words are precisely
its successfully traversed table descriptors, in order. No new executor,
observation, permission check or source-success condition is introduced. -/
inductive PathPermissionAnnotation (observe : Observation) (paBits : Nat) (va : BitVec 64)
    (controls : S1LogicalReference.Controls) :
    {level bits : Nat} → {base : BitVec 48} → {endpoint : PathEnd} →
    Path observe paBits va level bits base endpoint →
    TablePermissions → List (BitVec 64) → TablePermissions → Prop where
  | invalid (level bits : Nat) (base : BitVec 48) (physical : FullAddress)
      (view : S1DescriptorPIE.View 64)
      (hl : level ≤ 3) (aligned : entryAddress base va level bits % 8 = 0)
      (present : observe (entryAddress base va level bits) physical view)
      (kind : descriptorKind level view.stable = .ok .invalid)
      (prior : TablePermissions) :
      PathPermissionAnnotation observe paBits va controls
        (.invalid level bits base physical view hl aligned present kind) prior [] prior
  | leaf (level bits : Nat) (base : BitVec 48) (physical : FullAddress)
      (view : S1DescriptorPIE.View 64)
      (hl : level ≤ 3) (aligned : entryAddress base va level bits % 8 = 0)
      (present : observe (entryAddress base va level bits) physical view)
      (kind : descriptorKind level view.stable = .ok .leaf)
      (prior : TablePermissions) :
      PathPermissionAnnotation observe paBits va controls
        (.leaf level bits base physical view hl aligned present kind) prior [] prior
  | range (level bits : Nat) (base : BitVec 48) (physical : FullAddress)
      (view : S1DescriptorPIE.View 64)
      (hl : level < 3) (aligned : entryAddress base va level bits % 8 = 0)
      (present : observe (entryAddress base va level bits) physical view)
      (kind : descriptorKind level view.stable = .ok .table)
      (outOfRange : 2^paBits ≤ entryAddress (childBase view) va (level+1) 9)
      (prior : TablePermissions) :
      PathPermissionAnnotation observe paBits va controls
        (.range level bits base physical view hl aligned present kind outOfRange) prior [] prior
  | table (level bits : Nat) (base : BitVec 48) (physical : FullAddress)
      (view : S1DescriptorPIE.View 64) (endpoint : PathEnd)
      (hl : level < 3) (aligned : entryAddress base va level bits % 8 = 0)
      (present : observe (entryAddress base va level bits) physical view)
      (kind : descriptorKind level view.stable = .ok .table)
      (inRange : entryAddress (childBase view) va (level+1) 9 < 2^paBits)
      (tail : Path observe paBits va (level+1) 9 (childBase view) endpoint)
      (prior final : TablePermissions) (words : List (BitVec 64))
      (annotation : PathPermissionAnnotation observe paBits va controls tail
        (tablePermissions controls prior view.stable) words final) :
      PathPermissionAnnotation observe paBits va controls
        (.table level bits base physical view endpoint hl aligned present kind inRange tail)
        prior (view.stable :: words) final

theorem path_annotation_exists {observe : Observation} {paBits : Nat} {va : BitVec 64}
    (controls : S1LogicalReference.Controls) {level bits : Nat} {base : BitVec 48} {endpoint : PathEnd}
    (path : Path observe paBits va level bits base endpoint) (prior : TablePermissions) :
    ∃ words final, PathPermissionAnnotation observe paBits va controls path prior words final := by
  induction path generalizing prior with
  | invalid level bits base physical view hl aligned present kind =>
    exact ⟨[], prior, .invalid level bits base physical view hl aligned present kind prior⟩
  | leaf level bits base physical view hl aligned present kind =>
    exact ⟨[], prior, .leaf level bits base physical view hl aligned present kind prior⟩
  | range level bits base physical view hl aligned present kind outOfRange =>
    exact ⟨[], prior, .range level bits base physical view hl aligned present kind outOfRange prior⟩
  | table level bits base physical view endpoint hl aligned present kind inRange tail ih =>
    obtain ⟨words, final, annotation⟩ := ih (tablePermissions controls prior view.stable)
    exact ⟨view.stable :: words, final,
      .table level bits base physical view endpoint hl aligned present kind inRange tail prior final words annotation⟩

theorem path_annotation_fold {observe : Observation} {paBits : Nat} {va : BitVec 64}
    {controls : S1LogicalReference.Controls} {level bits : Nat} {base : BitVec 48} {endpoint : PathEnd}
    {path : Path observe paBits va level bits base endpoint} {prior final : TablePermissions}
    {words : List (BitVec 64)}
    (annotation : PathPermissionAnnotation observe paBits va controls path prior words final) :
    final = words.foldl (fun previous word => tablePermissions controls previous word) prior := by
  induction annotation <;> first | rfl | assumption

#print axioms path_annotation_exists
