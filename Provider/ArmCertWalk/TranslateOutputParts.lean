    let args := e.getAppArgs
    let computation := args[args.size - 2]!
    if (computation.find? (·.isConstOf ``ArmFull.Functions.HaveMTE2Ext)).isSome &&
        (computation.find? (·.isConstOf ``ArmFull.Functions.NormalNCMemAttr)).isSome then
      let mut replaced := args
      for (term, index, name) in [(computation, args.size - 2, `ArmCertWalk.TranslateOutputParts.selection),
          (args.back!, args.size - 1, `ArmCertWalk.TranslateOutputParts.finish)] do
