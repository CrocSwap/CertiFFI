  | .lam name ty body bi =>
    withLocalDecl name bi ty fun x => do
      let (value, n) ← replaceParts (locals.push x) (body.instantiate1 x)
      return (← mkLambdaFVars #[x] value, n)
  | .letE name ty value body nondep =>
