    withLocalDeclD name ty fun x => do
      let (body', k) ← replaceParts (locals.push x) (body.instantiate1 x)
      return (.letE name ty v (body'.abstract #[x]) nondep, n + k)
  | .app f a =>
    let (f', n) ← replaceParts locals f
    let (a', k) ← replaceParts locals a
    return (.app f' a', n + k)
  | .mdata md body =>
    let (value, n) ← replaceParts locals body
    return (.mdata md value, n)
  | .proj name index body =>
    let (value, n) ← replaceParts locals body
    return (.proj name index value, n)
  | _ => return (e, 0)

