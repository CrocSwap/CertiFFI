set_option autoImplicit false
set_option maxHeartbeats 1000000
set_option maxRecDepth 100000

/-! # Runtime c11 CT positive C2 (generated by gen_ct_case.py; ct_c2_reduce / heap_ct_c2 pattern). -/

namespace ReleaseProfile.GB10.Runtime

open ReleaseProfile.MachineSource ReleaseProfile.GB10

def CTC2_c11 (rho : AdmissibleSourceCompletion) (callers : AdmissibleCTCallers rho) : Prop :=
  ∃ (domain : ArmCert.Translate.Model.QueryDomain) (spec : ArmCert.Translate.Model.TopologyImageSpec domain)
    (rows : List ArmCert.Translate.Model.PermissionRow) (mapping : BitVec 64 → Option Nat) (table : Nat → Prop) (sc : Nat → Prop) (bytes : Array Nat) (base : BitVec 64) (ifunc : Nat → MemReloc.Word) (p : R14E17.Pins) (budget : Nat) (inputs1 : List (BitVec 64)) (inputs2 : List (BitVec 64)) (entry1 entry2 : ArmBridge.Draft.NativeState),
    AgreesAt (Configuration.ofSource rho callers.first) entry1.regs ∧
    AgreesAt (Configuration.ofSource rho callers.second) entry2.regs ∧ SourceSpec rho callers.first spec ∧
    CTResidual_c11 spec rows mapping table sc bytes base ifunc p budget inputs1 inputs2 rho callers entry1 entry2

theorem ct_c2_reduce_c11 (rho : AdmissibleSourceCompletion) (callers : AdmissibleCTCallers rho)
    (sem1 sem2 : ModelSemantics) (payloadOf1 payloadOf2 : BitVec 88 → ModelPayload)
    (disabled1 : ∀ pcount, TimersDisabled (payloadOf1 pcount).data.timers)
    (disabled2 : ∀ pcount, TimersDisabled (payloadOf2 pcount).data.timers)
    {domain : ArmCert.Translate.Model.QueryDomain} (tables : TopologyTables domain) (oracle : OracleChoice)
    (rows : List ArmCert.Translate.Model.PermissionRow) (mapping : BitVec 64 → Option Nat) (table : Nat → Prop) (sc : Nat → Prop) (bytes : Array Nat) (base : BitVec 64) (ifunc : Nat → MemReloc.Word) (p : R14E17.Pins) (budget : Nat) (inputs1 : List (BitVec 64)) (inputs2 : List (BitVec 64))
    (residual : ∀ (p1 p2 : BitVec 88) (spec : ArmCert.Translate.Model.TopologyImageSpec domain),
      SourceSpec rho callers.first spec →
      spec.layout = tables.layout → spec.logicalRows = tables.logicalRows → spec.imageRows = tables.imageRows →
      TimersQuiet (makeModelEntry sem1 rho callers.first (payloadOf1 p1)).regs budget →
      TimersQuiet (makeModelEntry sem2 rho callers.second (payloadOf2 p2)).regs budget →
      CTResidual_c11 spec rows mapping table sc bytes base ifunc p budget inputs1 inputs2 rho callers
        (makeModelEntry sem1 rho callers.first (payloadOf1 p1)) (makeModelEntry sem2 rho callers.second (payloadOf2 p2))) :
    CTC2_c11 rho callers := by
  obtain ⟨p1, -⟩ : ∃ _ : BitVec 88, True := ⟨0#88, trivial⟩
  obtain ⟨p2, -⟩ : ∃ _ : BitVec 88, True := ⟨0#88, trivial⟩
  have timers1 := model_timersQuiet sem1 rho callers.first (payloadOf1 p1) (disabled1 p1) budget
  have timers2 := model_timersQuiet sem2 rho callers.second (payloadOf2 p2) (disabled2 p2) budget
  obtain ⟨spec, sspec, hl, hlr, hir⟩ := sourceSpec_of_tables rho callers.first tables oracle (payloadOf1 p1).data
    (makeModelEntry sem1 rho callers.first (payloadOf1 p1)) rfl
  exact ⟨domain, spec, rows, mapping, table, sc, bytes, base, ifunc, p, budget, inputs1, inputs2,
    makeModelEntry sem1 rho callers.first (payloadOf1 p1), makeModelEntry sem2 rho callers.second (payloadOf2 p2),
    makeModelEntry_agrees sem1 rho callers.first (payloadOf1 p1),
    makeModelEntry_agrees sem2 rho callers.second (payloadOf2 p2),
    sspec, residual p1 p2 spec sspec hl hlr hir timers1 timers2⟩

end ReleaseProfile.GB10.Runtime

namespace ReleaseProfile.GB10.RuntimeC2.c11

open ArmCertValue ReleaseProfile.MachineSource ReleaseProfile.GB10 ReleaseProfile.GB10.Runtime ReleaseProfile.GB10.RuntimeC2

section ct
variable (rho : AdmissibleSourceCompletion) (caller : AdmissibleCaller rho) (pcount : BitVec 88)

/-- Images at the entry of `caller`, for a spec pinned at any admitted caller and any caller's attributes. -/
theorem world_images_at {domain : ArmCert.Translate.Model.QueryDomain} {spec : ArmCert.Translate.Model.TopologyImageSpec domain}
    {specCaller : AdmissibleCaller rho} (cfgCaller : AdmissibleCaller rho)
    (sspec : SourceSpec rho specCaller spec) (hir : spec.imageRows = RuntimeGB10.World.imageRows) :
    ArmCert.Translate.Model.CurrentImagesAt spec (sourceAttributes rho cfgCaller) RuntimeGB10.World.permissionRows
        (ArmBridge.CruxGenGuarded.beforeFetchState (E rho caller pcount)) ∧
      ArmCertWalk.RawImageAt spec.imageRows (ArmBridge.CruxGenGuarded.beforeFetchState (E rho caller pcount)).mem := by
  obtain ⟨ha, hd, pie, -, -, -, -, -, -, cpie, -⟩ :=
    sourceSpec_walkLiterals rho specCaller sspec ((world rho caller).payload pcount).data
  have wxn := wxn_lit rho specCaller sspec ((world rho caller).payload pcount).data
  have cha := controls_ha_lit rho specCaller sspec ((world rho caller).payload pcount).data
  have chd := controls_hd_lit rho specCaller sspec ((world rho caller).payload pcount).data
  have cov := (sspec.overlay ((world rho caller).payload pcount).data).trans (overlay_source rho specCaller _)
  have nv1 := nv1Mode_el20 spec.controls sspec.regime
  refine images_of_checks spec (sourceAttributes rho cfgCaller) RuntimeGB10.World.permissionRows _
    (plan := RuntimeGB10.WorldPlan.plan RuntimeGB10.WorldCases.c11.db) (sat rho caller pcount) ?_ ?_ ?_ ?_ ?_ ?_ _
    (off_before rho caller pcount) (off_before rho caller pcount) ?_
  · intro x hx
    rw [hir] at hx
    exact List.mem_append_left _ (List.mem_append_right _ hx)
  · rw [hir]; unfold ArmCert.Translate.Model.PermissionRowsDeclared; decide
  · rw [hir]; decide
  · rw [hir, pie, ha, hd]; decide
  · rw [hir]; exact checkAttr_world rho cfgCaller
  · rw [hir]; exact checkWB_world rho cfgCaller
  · rw [checkPermissionImagePure_noOverlay _ _ _ _ (off_before rho caller pcount)]
    simp only [checkPermissionImageNoOverlay, permissionParamsView, ha, hd, pie, wxn,
      ArmCertWalk.descriptorPermissionView, S1LogicalReference.leafPermissions,
      S1LogicalReference.classicPermissions, nv1, cpie, cha, chd, cov, Bool.false_eq_true, ↓reduceIte]
    decide

theorem noUpd_at {domain : ArmCert.Translate.Model.QueryDomain} {spec : ArmCert.Translate.Model.TopologyImageSpec domain}
    {specCaller : AdmissibleCaller rho}
    (sspec : SourceSpec rho specCaller spec) (hir : spec.imageRows = RuntimeGB10.World.imageRows) :
    ∀ (wr : Bool) (acc : ArmFull.AccessDescriptor), ArmCert.Translate.Model.DataShape wr acc →
      ArmCertWalk.NoUpdateRows { spec.params with haft := ArmCert.Translate.Model.hostHAFT (E rho caller pcount).regs }
        acc spec.imageRows = true := by
  obtain ⟨ha, hd, pie, -⟩ := sourceSpec_walkLiterals rho specCaller sspec ((world rho caller).payload pcount).data
  have f189 := sourceRegs_feature rho caller ((world rho caller).payload pcount).data 189 (by decide) false _ rfl
  refine noUpd_of_view _ _ (fun w => ?_)
  simp only [noUpdateParamsView, ha, hd, pie]
  have haft : ArmCert.Translate.Model.hostHAFT (E rho caller pcount).regs = 0#1 := by
    unfold ArmCert.Translate.Model.hostHAFT
    show (if (sourceRegs rho caller ((world rho caller).payload pcount).data).FeatureImpl[189] && _ && _ then _ else _) = _
    rw [f189]
    rfl
  rw [haft, hir]
  cases w <;> decide

end ct

theorem residual_ct (rho : AdmissibleSourceCompletion) (callers : AdmissibleCTCallers rho) (p1 p2 : BitVec 88)
    (spec : ArmCert.Translate.Model.TopologyImageSpec (fun q => ∃ q0 ∈ RuntimeGB10.World.queries, ArmCertWalk.SamePage q0.va q.va))
    (sspec : SourceSpec rho callers.first spec) (hlay : spec.layout = Runtime.World.tables.layout)
    (hlr : spec.logicalRows = Runtime.World.tables.logicalRows) (hir : spec.imageRows = Runtime.World.tables.imageRows)
    (timers1 : TimersQuiet ((world rho callers.first).entry worldSemantics rho callers.first p1).regs (world rho callers.first).budget)
    (timers2 : TimersQuiet ((world rho callers.second).entry worldSemantics rho callers.second p2).regs (world rho callers.first).budget) :
    CTResidual_c11 spec (world rho callers.first).rows (world rho callers.first).mapping (world rho callers.first).table (world rho callers.first).sc (world rho callers.first).bytes (world rho callers.first).base (world rho callers.first).ifunc (world rho callers.first).p (world rho callers.first).budget (world rho callers.first).inputs (world rho callers.second).inputs rho callers ((world rho callers.first).entry worldSemantics rho callers.first p1) ((world rho callers.second).entry worldSemantics rho callers.second p2) := by
  have hir' : spec.imageRows = RuntimeGB10.World.imageRows := hir
  have hlr' : spec.logicalRows = RuntimeGB10.World.logicalRows := hlr
  have hlay' : spec.layout = RuntimeGB10.World.layout := hlay
  rw [w_rows rho callers.first, w_mapping rho callers.first, w_table rho callers.first, w_sc rho callers.first,
    w_bytes rho callers.first, w_base rho callers.first, w_ifunc rho callers.first, w_p rho callers.first,
    w_budget rho callers.first, w_inputs rho callers.first, w_inputs rho callers.second]
  rw [w_budget] at timers1 timers2
  refine ⟨timers1, timers2, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- a10 card:r14-code-binds
    exact ⟨R14Sparse.binds⟩
  · -- a11 card:r14-code-binds
    exact ⟨R14Sparse.codeBinds⟩
  · -- a16 card:runtime-code-static/covers
    exact ⟨PipeR14.closure_covers⟩
  · -- a17 card:runtime-code-static/separated
    exact ⟨by rw [hir']; exact RuntimeGB10.WorldStatics.separatedAt⟩
  · -- a18 card:runtime-code-static/contiguous
    exact ⟨RuntimeGB10.WorldStatics.contiguous⟩
  · -- a19 card:runtime-code-static/notMMIO
    exact ⟨RuntimeGB10.WorldStatics.notMMIO⟩
  · -- a20 E34
    exact ⟨by rw [hlr']; exact RuntimeGB10.World.keys_nodup⟩
  · -- a24 card:input-vector-shape
    exact ⟨length _ _ _ _⟩
  · -- a25 card:path-selector
    exact ⟨path _ _ _ _⟩
  · -- a27 comp:caller:image-table-separated
    exact ⟨by rw [hir']; exact RuntimeGB10.WorldStatics.separatedAt⟩
  · -- a28 card:load-base-page
    exact ⟨by decide⟩
  · -- a29 E31
    exact ⟨by decide⟩
  · -- a30 card:consumer-map-agrees
    have h := R14E17.consumer_agrees spec R14Plan.accesses_c11 R14Plan.codeWords_c11 R14Plan.entry_c11
      RuntimeGB10.WorldCases.c11.pins (0x400000#64 : BitVec 64).toNat RuntimeGB10.World.mapping mapped
    rw [hir'] at h
    exact ⟨h⟩
  · -- a31 card:budget
    exact ⟨Nat.le_refl _⟩
  · -- a66 card:default-initial/v1/current/images/covered
    exact ⟨(world_images_at rho callers.first p1 callers.first sspec hir').1.covered⟩
  · -- a67 card:default-initial/v1/current/images/topology
    exact ⟨(world_images_at rho callers.first p1 callers.first sspec hir').1.topology⟩
  · -- a68 card:default-initial/v1/current/images/attributes
    exact ⟨(world_images_at rho callers.first p1 callers.first sspec hir').1.attributes⟩
  · -- a69 card:default-initial/v1/current/images/writeback
    exact ⟨(world_images_at rho callers.first p1 callers.first sspec hir').1.writeback⟩
  · -- a70 card:default-initial/v1/current/images/permissions
    exact ⟨(world_images_at rho callers.first p1 callers.first sspec hir').1.permissions⟩
  · -- a132 card:default-initial/v1/pc
    refine ⟨?_⟩
    show (0x400000#64 + BitVec.ofNat 64 R14Plan.entry_c11 : BitVec 64) = 0x400000#64 + PipeR14.offset_c11 0
    decide
  · -- a133 card:runtime-default-initial/closed
    exact ⟨RuntimeClosed.closed_c11
      (RuntimeClosed.worldSpec_of_source sspec ((world rho callers.first).payload p1).data hlr' hir' hlay')
      (fun _ h => h) _ (RuntimeClosed.worldRegs_before (by
        rw [w_entry rho callers.first worldSemantics p1]
        exact RuntimeClosed.worldRegs_c11 worldSemantics rho callers.first p1))⟩
  · -- a134 card:runtime-default-initial/placed
    exact ⟨RuntimeGB10.WorldStatics.placedAt RuntimeGB10.WorldCases.c11.db R14Sparse.imageBytes R14Sparse.binds
      R14Sparse.codeBinds _ (E rho callers.first p1) (sat rho callers.first p1)⟩
  · -- a221 card:runtime-default-initial/raw
    exact ⟨(world_images_at rho callers.first p1 callers.first sspec hir').2⟩
  · -- a222 card:runtime-default-initial/noUpd
    exact ⟨noUpd_at rho callers.first p1 sspec hir'⟩
  · -- a254 card:runtime-initial/extra
    have agree := RuntimeGB10.WorldDs.agreesAt_zero RuntimeGB10.World.mapping
      (PipeR14.pinv RuntimeGB10.WorldCases.c11.pins) PipeR14.regions_c11 PipeR14.rs_c11 PipeR14.plan_c11
      RuntimeGB10.WorldCases.c11.db (E rho callers.first p1) (sat rho callers.first p1) (by decide +kernel)
    rw [inputs_entry rho callers.first p1, w_inputs] at agree
    exact ⟨agree⟩
  · -- a255 card:runtime-initial/statusRows
    exact ⟨model_tagStatusRows rho callers.first _ _⟩
  · -- a257 card:input-vector-shape (entry2)
    exact ⟨length _ _ _ _⟩
  · -- a258 card:path-selector (entry2)
    exact ⟨path _ _ _ _⟩
  · -- a260 comp:caller:image-table-separated
    exact ⟨by rw [hir']; exact RuntimeGB10.WorldStatics.separatedAt⟩
  · -- a261 card:load-base-page
    exact ⟨by decide⟩
  · -- a262 E31
    exact ⟨by decide⟩
  · -- a263 card:consumer-map-agrees
    have h := R14E17.consumer_agrees spec R14Plan.accesses_c11 R14Plan.codeWords_c11 R14Plan.entry_c11
      RuntimeGB10.WorldCases.c11.pins (0x400000#64 : BitVec 64).toNat RuntimeGB10.World.mapping mapped
    rw [hir'] at h
    exact ⟨h⟩
  · -- a264 card:budget
    exact ⟨Nat.le_refl _⟩
  · -- a299 card:default-initial/v1/current/images/covered
    exact ⟨(world_images_at rho callers.first p1 callers.first sspec hir').1.covered⟩
  · -- a300 card:default-initial/v1/current/images/topology (entry2)
    exact ⟨(world_images_at rho callers.second p2 callers.first sspec hir').1.topology⟩
  · -- a301 card:default-initial/v1/current/images/attributes (entry2)
    exact ⟨(world_images_at rho callers.second p2 callers.first sspec hir').1.attributes⟩
  · -- a302 card:default-initial/v1/current/images/writeback (entry2)
    exact ⟨(world_images_at rho callers.second p2 callers.first sspec hir').1.writeback⟩
  · -- a303 card:default-initial/v1/current/images/permissions (entry2)
    exact ⟨(world_images_at rho callers.second p2 callers.first sspec hir').1.permissions⟩
  · -- a365 card:default-initial/v1/pc (entry2)
    refine ⟨?_⟩
    show (0x400000#64 + BitVec.ofNat 64 R14Plan.entry_c11 : BitVec 64) = 0x400000#64 + PipeR14.offset_c11 0
    decide
  · -- a366 card:runtime-default-initial/closed (entry2)
    exact ⟨RuntimeClosed.closed_c11
      (RuntimeClosed.worldSpec_of_source sspec ((world rho callers.first).payload p1).data hlr' hir' hlay')
      (fun _ h => h) _ (RuntimeClosed.worldRegs_before (by
        rw [w_entry rho callers.second worldSemantics p2]
        exact RuntimeClosed.worldRegs_c11 worldSemantics rho callers.second p2))⟩
  · -- a367 card:runtime-default-initial/placed (entry2)
    exact ⟨RuntimeGB10.WorldStatics.placedAt RuntimeGB10.WorldCases.c11.db R14Sparse.imageBytes R14Sparse.binds
      R14Sparse.codeBinds _ (E rho callers.second p2) (sat rho callers.second p2)⟩
  · -- a454 card:runtime-default-initial/raw (entry2)
    exact ⟨(world_images_at rho callers.second p2 callers.first sspec hir').2⟩
  · -- a455 card:runtime-default-initial/noUpd (entry2)
    exact ⟨noUpd_at rho callers.second p2 sspec hir'⟩
  · -- a487 card:runtime-initial/extra (entry2)
    have agree := RuntimeGB10.WorldDs.agreesAt_zero RuntimeGB10.World.mapping
      (PipeR14.pinv RuntimeGB10.WorldCases.c11.pins) PipeR14.regions_c11 PipeR14.rs_c11 PipeR14.plan_c11
      RuntimeGB10.WorldCases.c11.db (E rho callers.second p2) (sat rho callers.second p2) (by decide +kernel)
    rw [inputs_entry rho callers.second p2, w_inputs] at agree
    exact ⟨agree⟩
  · -- a488 card:runtime-initial/statusRows (entry2)
    exact ⟨model_tagStatusRows rho callers.second _ _⟩

/-- **Positive CT C2 for Runtime c11** at every admissible completion and admitted CT caller pair. -/
theorem ct_c2 (rho : AdmissibleSourceCompletion) (callers : AdmissibleCTCallers rho) : CTC2_c11 rho callers :=
  ct_c2_reduce_c11 rho callers worldSemantics worldSemantics (world rho callers.first).payload
    (world rho callers.second).payload (world_timers_disabled rho callers.first) (world_timers_disabled rho callers.second) Runtime.World.tables Runtime.World.oracle
    (world rho callers.first).rows (world rho callers.first).mapping (world rho callers.first).table (world rho callers.first).sc (world rho callers.first).bytes (world rho callers.first).base (world rho callers.first).ifunc (world rho callers.first).p (world rho callers.first).budget (world rho callers.first).inputs (world rho callers.second).inputs
    (fun p1 p2 spec sspec hlay hlr hir timers1 timers2 =>
      residual_ct rho callers p1 p2 spec sspec hlay hlr hir timers1 timers2)

end ReleaseProfile.GB10.RuntimeC2.c11

