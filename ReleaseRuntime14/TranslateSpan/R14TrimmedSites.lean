      decide (s.start = R14E17.dataVA p a.2.1 ∧ a.2.2.1 ≤ s.size))) = true := by
  simp [sites_c06, R14Plan.accesses_c06]

theorem bounded_c06 (p : R14E17.Pins) :
    (sites_c06 p).all (fun s => decide (s.region ∈ PipeR14.regions_c06 ∧ s.first+s.size ≤ 8*s.region.words)) = true := by rfl

theorem span_c06 {domain : QueryDomain} {spec : TopologyImageSpec domain}
    {config : AttributeConfig} {rows : List PermissionRow} {mapping : BitVec 64 → Option Nat}
    {p : R14E17.Pins} {loadBase : Nat} {table : Nat → Prop} {state : ArmCertWalk.State}
    (closed : ClosedMembershipAt spec config rows mapping (R14E17.consumerMap R14Plan.accesses_c06
      R14Plan.codeWords_c06 R14Plan.entry_c06 p loadBase mapping table) state)
    (image : TopologyImageAt spec state)
    (aligned : ∀ a ∈ R14Plan.accesses_c06, (R14E17.dataVA p a.2.1).toNat % a.2.2.1 = 0)
    (sp16 : p.regs 31 % 16 = 0)
    (distinct : ∀ r ∈ PipeR14.regions_c06, ∀ r' ∈ PipeR14.regions_c06, ∀ j j',
      j < 8*r.words → j' < 8*r'.words → regionVA p r j = regionVA p r' j' → r = r' ∧ j = j')
    (a : Nat × R14Plan.Base × Nat × Bool) (ha : a ∈ R14Plan.accesses_c06)
    (r : Region) (hr : r ∈ PipeR14.regions_c06) (j0 : Nat) (hw : j0+a.2.2.1 ≤ 8*r.words)
    (layout : ∀ t, t < a.2.2.1 → regionVA p r (j0+t) = R14E17.dataVA p a.2.1 + BitVec.ofNat 64 t) :
    ∀ t, t < a.2.2.1 → bytePA_c06 p mapping r (j0+t) = (mapping (R14E17.dataVA p a.2.1)).map (· + t) := by
  obtain ⟨s, hs, good⟩ := List.any_eq_true.1 (List.all_eq_true.1 (complete_c06 p) a ha)
  obtain ⟨start, size⟩ := of_decide_eq_true good
  have bound := of_decide_eq_true (List.all_eq_true.1 (bounded_c06 p) s hs)
  have h := TranslateSpan.siteView_span_of_layout PipeR14.regions_c06 (regionVA p) image (current_c06 closed)
    (geometry_c06 p aligned sp16) distinct s hs bound.1 bound.2 r hr j0 a.2.2.1 size hw
  rw [start] at h
  exact h layout

theorem injective_c06 (p : R14E17.Pins) (mapping : BitVec 64 → Option Nat)
    (aligned : ∀ a ∈ R14Plan.accesses_c06, (R14E17.dataVA p a.2.1).toNat % a.2.2.1 = 0)
    (sp16 : p.regs 31 % 16 = 0)
    (distinct : ∀ r ∈ PipeR14.regions_c06, ∀ r' ∈ PipeR14.regions_c06, ∀ j j',
      j < 8*r.words → j' < 8*r'.words → regionVA p r j = regionVA p r' j' → r = r' ∧ j = j')
    (nonalias : TranslateSpan.SpanNonalias (sites_c06 p) mapping) :
    ∀ a ∈ TranslateSpan.bytesOf PipeR14.regions_c06, ∀ b ∈ TranslateSpan.bytesOf PipeR14.regions_c06, a ≠ b → ∀ pa,
      bytePA_c06 p mapping a.1 a.2 = some pa → bytePA_c06 p mapping b.1 b.2 ≠ some pa := by
  apply TranslateSpan.siteView_injective_of_spans (TranslateSpan.bytesOf PipeR14.regions_c06) (regionVA p)
  · intro a ha b hb ne same
    have aa := TranslateSpan.bytesOf_mem ha
    have bb := TranslateSpan.bytesOf_mem hb
    obtain ⟨r, j⟩ := a
    obtain ⟨r', j'⟩ := b
    have eq := distinct r aa.1 r' bb.1 j j' aa.2 bb.2 same
    exact ne (Prod.ext eq.1 eq.2)
  · exact geometry_c06 p aligned sp16
  · exact nonalias

