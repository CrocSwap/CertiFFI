      change BitVec.ofInt 64 _ = BitVec.ofInt 64 (R14E17.baseVA p (.pin 31 (-32))) + BitVec.ofNat 64 i
      rw [raw, BitVec.ofInt_add, BitVec.ofInt_natCast]
