    exact ⟨(world_images rho caller pcount sspec hir').2⟩
  · -- a221 card:runtime-default-initial/noUpd
    exact ⟨noUpd rho caller pcount sspec hir'⟩
  · -- a253 card:runtime-initial/extra
    have agree := RuntimeGB10.WorldDs.agreesAt_zero RuntimeGB10.World.mapping
      (PipeR14.pinv RuntimeGB10.WorldCases.c08.pins) PipeR14.regions_c08 PipeR14.rs_c08 PipeR14.plan_c08
      RuntimeGB10.WorldCases.c08.db (E rho caller pcount) (sat rho caller pcount) (by decide +kernel)
    rw [inputs_entry rho caller pcount, w_inputs] at agree
    exact ⟨agree⟩
  · -- a254 card:runtime-initial/statusRows
    exact ⟨model_tagStatusRows rho caller _ _⟩

/-- **Positive fullpc C2 for Runtime c08** at every admissible completion and caller. -/
theorem fullpc_c2 (rho : AdmissibleSourceCompletion) (caller : AdmissibleCaller rho) : FullPCC2_c08 rho caller :=
  fullpc_c2_reduce_c08 rho caller worldSemantics (world rho caller).payload (world_timers_disabled rho caller)
    Runtime.World.tables Runtime.World.oracle (world rho caller).rows (world rho caller).mapping
    (world rho caller).table (world rho caller).sc (world rho caller).bytes (world rho caller).base
    (world rho caller).ifunc (world rho caller).p (world rho caller).budget (world rho caller).inputs
    (fun pcount spec sspec hlay hlr hir timers => residual_fullpc rho caller pcount spec sspec hlay hlr hir timers)

end ReleaseProfile.GB10.RuntimeC2.c08

