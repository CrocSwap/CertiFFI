theorem nb_ok : totalL PipeR14.rs_c08 = 0 := by decide

theorem path (n z c v : BitVec 1) :
    ArmCertPipe.PathOK (extend (flagged R14GuardWitness.c08.inputs 0 n z c v) PipeR14.D_c08) PipeR14.guards_c08 := by
  rcases bit1_cases n with rfl | rfl <;> rcases bit1_cases z with rfl | rfl <;>
    rcases bit1_cases c with rfl | rfl <;> rcases bit1_cases v with rfl | rfl <;>
  · simp only [ArmCertPipe.PathOK, PipeR14.guards_c08, List.mem_cons, List.not_mem_nil, forall_eq_or_imp,
      false_implies, ArmCertPipe.Guard.holds, and_true, implies_true]
    repeat' (first | exact True.intro | constructor)
    all_goals decide +kernel

theorem length (n z c v : BitVec 1) : (flagged R14GuardWitness.c08.inputs 0 n z c v).length = PipeR14.n0_c08 := by
  simp only [flagged, List.length_set]; exact R14GuardWitness.c08.length

theorem bytes_ok : ∀ t < 0,
    (RuntimeGB10.WorldDs.byteInput RuntimeGB10.World.mapping (PipeR14.pinv RuntimeGB10.WorldCases.c08.pins) RuntimeGB10.WorldCases.c08.db PipeR14.rs_c08 t).setWidth 64 =
      R14GuardWitness.c08.inputs.getD t 0 := by
  decide +kernel

theorem gprs_ok : ∀ (k : Nat) (hk : k < 31), RuntimeGB10.WorldCases.c08.gprs[k] = R14GuardWitness.c08.inputs.getD (0 + k) 0 := by
  decide +kernel

theorem inputs_model (x : ArmBridge.Draft.NativeState) (hg : x.regs.gpr = RuntimeGB10.WorldCases.c08.gprs) (hsp : x.regs.SP_EL0 = 0x200000#64) :
    mkInputsL x PipeR14.rs_c08 (RuntimeGB10.WorldDs.byteInput RuntimeGB10.World.mapping (PipeR14.pinv RuntimeGB10.WorldCases.c08.pins) RuntimeGB10.WorldCases.c08.db PipeR14.rs_c08) =
      flagged R14GuardWitness.c08.inputs 0 x.regs.PSTATE.N x.regs.PSTATE.Z x.regs.PSTATE.C x.regs.PSTATE.V := by
  have glen : R14GuardWitness.c08.inputs.length = 36 := by rw [R14GuardWitness.c08.length]; decide
  have key : ∀ t, t < 36 → inputValG x 0 (RuntimeGB10.WorldDs.byteInput RuntimeGB10.World.mapping
        (PipeR14.pinv RuntimeGB10.WorldCases.c08.pins) RuntimeGB10.WorldCases.c08.db PipeR14.rs_c08) t =
      (flagged R14GuardWitness.c08.inputs 0 x.regs.PSTATE.N x.regs.PSTATE.Z x.regs.PSTATE.C x.regs.PSTATE.V).getD t 0 := by
    intro t ht
    unfold inputValG
    simp only [flagged, List.getD_eq_getElem?_getD, List.getElem?_set, List.length_set, glen]
    by_cases h1 : t < 0
    · have a : ¬ (0 + 35 = t) := by omega
      have b : ¬ (0 + 34 = t) := by omega
      have c : ¬ (0 + 33 = t) := by omega
      have d : ¬ (0 + 32 = t) := by omega
      rw [if_pos h1]; simp only [a, b, c, d, if_false, Bool.false_and]
      rw [← List.getD_eq_getElem?_getD]; exact bytes_ok t h1
    · by_cases h2 : t < 0 + 31
      · have a : ¬ (0 + 35 = t) := by omega
        have b : ¬ (0 + 34 = t) := by omega
        have c : ¬ (0 + 33 = t) := by omega
        have d : ¬ (0 + 32 = t) := by omega
        rw [if_neg h1, dif_pos h2]; simp only [a, b, c, d, if_false, Bool.false_and]
        rw [← List.getD_eq_getElem?_getD]
        simp only [HeapV2StepCerts.RegBind.regVal, hg]
        have := gprs_ok (t - 0) (by omega)
        rw [show 0 + (t - 0) = t by omega] at this
        exact this
      · by_cases h3 : t = 0 + 31
        · subst h3
          rw [if_neg h1, dif_neg h2, if_pos rfl]
          simp [HeapV2StepCerts.RegBind.regVal, hsp]
          first | rfl | decide
        · rw [if_neg h1, dif_neg h2, if_neg h3]
          by_cases h4 : t = 0 + 32
          · subst h4; simp
          · by_cases h5 : t = 0 + 33
            · subst h5; simp
            · by_cases h6 : t = 0 + 34
              · subst h6; simp
              · have h7 : t = 0 + 35 := by omega
                subst h7; simp
  apply List.ext_getElem
  · simp only [mkInputsL, mkInputsG_length, nb_ok, flagged, List.length_set, glen]
  · intro t h1 h2
    have ht : t < 36 := by simpa only [mkInputsL, mkInputsG_length, nb_ok] using h1
    rw [List.getElem_eq_getD (0 : BitVec 64), List.getElem_eq_getD (0 : BitVec 64)]
    simp only [mkInputsL, nb_ok]
    rw [mkInputsG_getD _ _ _ _ (by omega)]
    exact key t ht

theorem mapped : ∀ va acc size, R14E17.Permitted R14Plan.accesses_c08 R14Plan.codeWords_c08 R14Plan.entry_c08
    RuntimeGB10.WorldCases.c08.pins (0x400000#64 : BitVec 64).toNat va acc size →
    ∃ pa, RuntimeGB10.World.mapping va = some pa ∧ pa < 2 ^ 56 := by
  have hd : R14Plan.accesses_c08.all (fun a => mappedB RuntimeGB10.World.mapping (R14E17.dataVA RuntimeGB10.WorldCases.c08.pins a.2.1)) = true := by
    decide +kernel
  have hc : R14Plan.codeWords_c08.all (fun c => mappedB RuntimeGB10.World.mapping
      (R14E17.codeVA (0x400000#64 : BitVec 64).toNat R14Plan.entry_c08 c.1)) = true := by decide +kernel
  intro va acc size permitted
  rcases permitted with ⟨a, m, hva, _, _⟩ | ⟨c, m, hva, _, _⟩
  · subst hva; exact mapped_of (List.all_eq_true.1 hd a m)
  · subst hva; exact mapped_of (List.all_eq_true.1 hc c m)

