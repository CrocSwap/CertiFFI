  | 2, hk => exact fun x y fx fy ix iy rx ry pcf => ArmCertPipe.ct_of_evob (ev_c13_2 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs1 bytePA cs (Nat.lt_of_lt_of_le hk hroom) page nodup) (ev_c13_2 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs2 bytePA cs (Nat.lt_of_lt_of_le hk hroom) page nodup) x y fx fy ix iy rx ry (by rw [ix.v2.v1.pc, iy.v2.v1.pc]) pcf
  | 3, hk => exact fun x y fx fy ix iy rx ry pcf => ArmCertPipe.ct_of_evob (ev_c13_3 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs1 bytePA cs (Nat.lt_of_lt_of_le hk hroom) page low nodup) (ev_c13_3 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs2 bytePA cs (Nat.lt_of_lt_of_le hk hroom) page low nodup) x y fx fy ix iy rx ry (by rw [ix.v2.v1.pc, iy.v2.v1.pc]) pcf
  | 4, hk => exact fun x y fx fy ix iy rx ry pcf => ArmCertPipe.ct_of_evob (ev_c13_4 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs1 bytePA cs (Nat.lt_of_lt_of_le hk hroom) page low hlen1 hpath1 nodup) (ev_c13_4 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs2 bytePA cs (Nat.lt_of_lt_of_le hk hroom) page low hlen2 hpath2 nodup) x y fx fy ix iy rx ry (by rw [ix.v2.v1.pc, iy.v2.v1.pc]) pcf
  | j + 5, hk => exact absurd hk (by rw [show plan_c13.length = 5 from rfl]; omega)

/-- Landing PCs of a non-final step agree on two runs (both base + offset_c13 (k+1), from Inv at k+1). -/
theorem ct_pc_c13 {domain : QueryDomain} (spec : TopologyImageSpec domain) (config : AttributeConfig)
    (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat) (table sc : Nat → Prop) (bytes : Array Nat)
    (base : BitVec 64) (ifunc : Nat → MemReloc.Word) (p : R14E17.Pins) (budget : Nat)
    (inputs1 inputs2 : List (BitVec 64)) (bytePA : ArmCertValue.Physical.BytePA) (k : Nat) (fx fy : NativeState)
    (ix : Inv_c13 spec config rows mapping table sc bytes base ifunc p budget inputs1 bytePA (k + 1) fx) (iy : Inv_c13 spec config rows mapping table sc bytes base ifunc p budget inputs2 bytePA (k + 1) fy) : fx.regs._PC = fy.regs._PC := by
  rw [ix.v2.v1.pc, iy.v2.v1.pc]

