/-- **runtime14 case c01: every step of the run succeeds** and lands on the next stateAt (for the CT induction). -/
theorem steps_dp_c01 (real : Type) [Sail.SailReal real] {domain : QueryDomain} (spec : TopologyImageSpec domain)
    (config : AttributeConfig) (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat) (table : Nat → Prop)
