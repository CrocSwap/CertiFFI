theorem run_c01 (real : Type) [Sail.SailReal real] {domain : QueryDomain} (spec : TopologyImageSpec domain)
    (config : AttributeConfig) (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat) (table : Nat → Prop)
    (sc : Nat → Prop) (bytes : Array Nat) (b : Binds bytes R14Scoped.slices) (cb : R14E17.CodeBinds bytes)
    (base : BitVec 64) (ifunc : Nat → MemReloc.Word) (p : R14E17.Pins) (budget : Nat) (inputs : List (BitVec 64)) (bytePA : ArmCertValue.Physical.BytePA)
    (cs : CodeStaticR14 sc mapping base (rowsFootprint spec.imageRows).byte)
    (page : base.toNat % 4096 = 0) (low : base.toNat < 2 ^ 54) (hlen : inputs.length = n0_c01) (hpath : ArmCertPipe.PathOK (extend inputs D_c01) guards_c01) (hlr : (inputs.getD 83 0).toNat < 2 ^ 54)
    (ds : DataStaticR14 mapping bytePA p (rowsFootprint spec.imageRows).byte dataSites_c01 regions_c01 sc base) (hp : PinsAgree p rs_c01 forms_c01 inputs)
    (hroom : plan_c01.length ≤ budget)
    (entry : NativeState) (init : Inv_c01 spec config rows mapping table sc bytes base ifunc p budget inputs bytePA 0 entry) :
    (∀ k, k < plan_c01.length → Inv_c01 spec config rows mapping table sc bytes base ifunc p budget inputs bytePA k (stateAt real entry k)) ∧
    ∃ fin, modelStep real (stateAt real entry (plan_c01.length - 1)) = .ok () fin ∧
      ArmCertPipe.Physical.AgreesAt bytePA regions_c01 σ0_c01 inputs plan_c01 plan_c01.length fin := by
  have hall : (compileRun regions_c01 σ0_c01 inputs.length plan_c01).isSome = true := by
    have hD := compiles_D_c01
    rw [← hlen] at hD
    cases hq : compileRun regions_c01 σ0_c01 inputs.length plan_c01 with
    | none => rw [hq] at hD; cases hD
    | some q => rfl
  exact ArmCertPipe.Physical.runG real entry (by decide) init hall
    (route_c01 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs bytePA cs page low hlen hpath hlr ds hp hroom)
    (nexts_c01 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs bytePA cs page low hlen hpath hlr ds hp hroom)

/-- **runtime14 case c01 release outputs**: the run reaches its last step and steps once more; at that state x0
    and every tracked output byte are the plan's D-table values (the math lemma rewrites these to the spec). -/
theorem release_c01 (real : Type) [Sail.SailReal real] {domain : QueryDomain} (spec : TopologyImageSpec domain)
    (config : AttributeConfig) (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat) (table : Nat → Prop)
    (sc : Nat → Prop) (bytes : Array Nat) (b : Binds bytes R14Scoped.slices) (cb : R14E17.CodeBinds bytes)
    (base : BitVec 64) (ifunc : Nat → MemReloc.Word) (p : R14E17.Pins) (budget : Nat) (inputs : List (BitVec 64)) (bytePA : ArmCertValue.Physical.BytePA)
    (cs : CodeStaticR14 sc mapping base (rowsFootprint spec.imageRows).byte)
    (page : base.toNat % 4096 = 0) (low : base.toNat < 2 ^ 54) (hlen : inputs.length = n0_c01) (hpath : ArmCertPipe.PathOK (extend inputs D_c01) guards_c01) (hlr : (inputs.getD 83 0).toNat < 2 ^ 54)
    (ds : DataStaticR14 mapping bytePA p (rowsFootprint spec.imageRows).byte dataSites_c01 regions_c01 sc base) (hp : PinsAgree p rs_c01 forms_c01 inputs)
    (hroom : plan_c01.length ≤ budget)
    (entry : NativeState) (init : Inv_c01 spec config rows mapping table sc bytes base ifunc p budget inputs bytePA 0 entry) :
    ∃ fin, modelStep real (stateAt real entry (plan_c01.length - 1)) = .ok () fin ∧
      HeapV2StepCerts.RegBind.regVal fin (.x 0) = (extend inputs D_c01).getD 106 0 ∧
      ∀ q ∈ outMemLocs_c01.zip outMem_c01, ∀ i b, q.2 = some (i, b) →
        ArmCertValue.Physical.regionByte bytePA fin q.1.1 q.1.2 = some ((((extend inputs D_c01).getD i 0) >>> (8 * b)).setWidth 8) := by
  obtain ⟨_, fin, run, hA⟩ := run_c01 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs bytePA cs page low hlen hpath hlr ds hp hroom entry init
  obtain ⟨σf, hall⟩ : ∃ σf, compileRun regions_c01 σ0_c01 inputs.length plan_c01 = some (D_c01, σf) := by
    have hD := compiles_D_c01
    rw [← hlen] at hD
    cases hq : compileRun regions_c01 σ0_c01 inputs.length plan_c01 with
    | none => rw [hq] at hD; cases hD
    | some q =>
      rw [hq] at hD
      simp only [Option.map_some] at hD
      have h1 : q.1 = D_c01 := Option.some.inj hD
      exact ⟨q.2, by rw [← h1]⟩
  have hE := ArmCertPipe.Physical.agrees_end hA hall
  refine ⟨fin, run, hE.1 _ 106 ?_, ArmCertPipe.Physical.outMem_end hE _ _ ?_⟩
  · have h := outReg_c01
    rw [← hlen, hall] at h
    simp only [Option.map_some] at h
    exact (List.cons.inj (Option.some.inj h)).1
  · have h := outMem_ok_c01
    rw [← hlen, hall] at h
    simp only [Option.map_some] at h
    exact Option.some.inj h

