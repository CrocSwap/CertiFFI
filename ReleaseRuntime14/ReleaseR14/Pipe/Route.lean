theorem nexts_c13 (real : Type) [Sail.SailReal real] {domain : QueryDomain} (spec : TopologyImageSpec domain)
    (config : AttributeConfig) (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat) (table : Nat → Prop)
    (sc : Nat → Prop) (bytes : Array Nat) (b : Binds bytes R14Scoped.slices) (cb : R14E17.CodeBinds bytes)
    (base : BitVec 64) (ifunc : Nat → MemReloc.Word) (p : R14E17.Pins) (budget : Nat) (inputs : List (BitVec 64)) (bytePA : ArmCertValue.Physical.BytePA)
    (cs : CodeStaticR14 sc mapping base (rowsFootprint spec.imageRows).byte)
    (page : base.toNat % 4096 = 0) (low : base.toNat < 2 ^ 54) (hlen : inputs.length = n0_c13) (hpath : ArmCertPipe.PathOK (extend inputs D_c13) guards_c13)
    (ds : DataStaticR14 mapping bytePA p (rowsFootprint spec.imageRows).byte dataSites_c13 regions_c13 sc base) (hp : PinsAgree p rs_c13 forms_c13 inputs)
    (hroom : plan_c13.length ≤ budget) :
    ∀ k, k + 1 < plan_c13.length →
      ArmCertPipe.Physical.NextOb real (Inv_c13 spec config rows mapping table sc bytes base ifunc p budget inputs bytePA) bytePA regions_c13 σ0_c13 inputs plan_c13 k := by
  intro k hk
  match k, hk with
  | 0, hk => exact next_c13_0 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs bytePA cs (Nat.lt_of_lt_of_le (Nat.lt_of_succ_lt hk) hroom) page low hlen hpath
  | 1, hk => exact next_c13_1 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs bytePA cs (Nat.lt_of_lt_of_le (Nat.lt_of_succ_lt hk) hroom) page hlen ds hp
  | 2, hk => exact next_c13_2 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs bytePA cs (Nat.lt_of_lt_of_le (Nat.lt_of_succ_lt hk) hroom) page
  | 3, hk => exact next_c13_3 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs bytePA cs (Nat.lt_of_lt_of_le (Nat.lt_of_succ_lt hk) hroom) page low hlen hpath
  | j + 4, hk => exact absurd hk (by rw [show plan_c13.length = 5 from rfl]; omega)

theorem route_c13 (real : Type) [Sail.SailReal real] {domain : QueryDomain} (spec : TopologyImageSpec domain)
    (config : AttributeConfig) (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat) (table : Nat → Prop)
    (sc : Nat → Prop) (bytes : Array Nat) (b : Binds bytes R14Scoped.slices) (cb : R14E17.CodeBinds bytes)
    (base : BitVec 64) (ifunc : Nat → MemReloc.Word) (p : R14E17.Pins) (budget : Nat) (inputs : List (BitVec 64)) (bytePA : ArmCertValue.Physical.BytePA)
    (cs : CodeStaticR14 sc mapping base (rowsFootprint spec.imageRows).byte)
    (page : base.toNat % 4096 = 0) (low : base.toNat < 2 ^ 54) (hlen : inputs.length = n0_c13) (hpath : ArmCertPipe.PathOK (extend inputs D_c13) guards_c13)
    (ds : DataStaticR14 mapping bytePA p (rowsFootprint spec.imageRows).byte dataSites_c13 regions_c13 sc base) (hp : PinsAgree p rs_c13 forms_c13 inputs)
    (hroom : plan_c13.length ≤ budget) :
    ∀ k (hk : k < plan_c13.length), StepFact real (Inv_c13 spec config rows mapping table sc bytes base ifunc p budget inputs bytePA) bytePA regions_c13 plan_c13 k hk := by
  intro k hk
  match k, hk with
  | 0, hk => exact sf_c13_0 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs bytePA cs (Nat.lt_of_lt_of_le hk hroom) page low hlen hpath
  | 1, hk => exact sf_c13_1 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs bytePA cs (Nat.lt_of_lt_of_le hk hroom) page hlen ds hp
  | 2, hk => exact sf_c13_2 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs bytePA cs (Nat.lt_of_lt_of_le hk hroom) page
  | 3, hk => exact sf_c13_3 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs bytePA cs (Nat.lt_of_lt_of_le hk hroom) page low
  | 4, hk => exact sf_c13_4 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs bytePA cs (Nat.lt_of_lt_of_le hk hroom) page low hlen hpath
  | j + 5, hk => exact absurd hk (by rw [show plan_c13.length = 5 from rfl]; omega)

theorem run_c13 (real : Type) [Sail.SailReal real] {domain : QueryDomain} (spec : TopologyImageSpec domain)
    (config : AttributeConfig) (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat) (table : Nat → Prop)
    (sc : Nat → Prop) (bytes : Array Nat) (b : Binds bytes R14Scoped.slices) (cb : R14E17.CodeBinds bytes)
    (base : BitVec 64) (ifunc : Nat → MemReloc.Word) (p : R14E17.Pins) (budget : Nat) (inputs : List (BitVec 64)) (bytePA : ArmCertValue.Physical.BytePA)
    (cs : CodeStaticR14 sc mapping base (rowsFootprint spec.imageRows).byte)
    (page : base.toNat % 4096 = 0) (low : base.toNat < 2 ^ 54) (hlen : inputs.length = n0_c13) (hpath : ArmCertPipe.PathOK (extend inputs D_c13) guards_c13)
    (ds : DataStaticR14 mapping bytePA p (rowsFootprint spec.imageRows).byte dataSites_c13 regions_c13 sc base) (hp : PinsAgree p rs_c13 forms_c13 inputs)
    (hroom : plan_c13.length ≤ budget)
    (entry : NativeState) (init : Inv_c13 spec config rows mapping table sc bytes base ifunc p budget inputs bytePA 0 entry) :
    (∀ k, k < plan_c13.length → Inv_c13 spec config rows mapping table sc bytes base ifunc p budget inputs bytePA k (stateAt real entry k)) ∧
    ∃ fin, modelStep real (stateAt real entry (plan_c13.length - 1)) = .ok () fin ∧
      ArmCertPipe.Physical.AgreesAt bytePA regions_c13 σ0_c13 inputs plan_c13 plan_c13.length fin := by
  have hall : (compileRun regions_c13 σ0_c13 inputs.length plan_c13).isSome = true := by
    have hD := compiles_D_c13
    rw [← hlen] at hD
    cases hq : compileRun regions_c13 σ0_c13 inputs.length plan_c13 with
    | none => rw [hq] at hD; cases hD
    | some q => rfl
  exact ArmCertPipe.Physical.runG real entry (by decide) init hall
    (route_c13 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs bytePA cs page low hlen hpath ds hp hroom)
    (nexts_c13 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs bytePA cs page low hlen hpath ds hp hroom)

/-- **runtime14 case c13 release outputs**: the run reaches its last step and steps once more; at that state x0
    and every tracked output byte are the plan's D-table values (the math lemma rewrites these to the spec). -/
theorem release_c13 (real : Type) [Sail.SailReal real] {domain : QueryDomain} (spec : TopologyImageSpec domain)
    (config : AttributeConfig) (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat) (table : Nat → Prop)
    (sc : Nat → Prop) (bytes : Array Nat) (b : Binds bytes R14Scoped.slices) (cb : R14E17.CodeBinds bytes)
    (base : BitVec 64) (ifunc : Nat → MemReloc.Word) (p : R14E17.Pins) (budget : Nat) (inputs : List (BitVec 64)) (bytePA : ArmCertValue.Physical.BytePA)
    (cs : CodeStaticR14 sc mapping base (rowsFootprint spec.imageRows).byte)
    (page : base.toNat % 4096 = 0) (low : base.toNat < 2 ^ 54) (hlen : inputs.length = n0_c13) (hpath : ArmCertPipe.PathOK (extend inputs D_c13) guards_c13)
    (ds : DataStaticR14 mapping bytePA p (rowsFootprint spec.imageRows).byte dataSites_c13 regions_c13 sc base) (hp : PinsAgree p rs_c13 forms_c13 inputs)
    (hroom : plan_c13.length ≤ budget)
    (entry : NativeState) (init : Inv_c13 spec config rows mapping table sc bytes base ifunc p budget inputs bytePA 0 entry) :
    ∃ fin, modelStep real (stateAt real entry (plan_c13.length - 1)) = .ok () fin ∧
      HeapV2StepCerts.RegBind.regVal fin (.x 0) = (extend inputs D_c13).getD 4 0 ∧
      ∀ q ∈ outMemLocs_c13.zip outMem_c13, ∀ i b, q.2 = some (i, b) →
        ArmCertValue.Physical.regionByte bytePA fin q.1.1 q.1.2 = some ((((extend inputs D_c13).getD i 0) >>> (8 * b)).setWidth 8) := by
  obtain ⟨_, fin, run, hA⟩ := run_c13 real spec config rows mapping table sc bytes b cb base ifunc p budget inputs bytePA cs page low hlen hpath ds hp hroom entry init
  obtain ⟨σf, hall⟩ : ∃ σf, compileRun regions_c13 σ0_c13 inputs.length plan_c13 = some (D_c13, σf) := by
    have hD := compiles_D_c13
    rw [← hlen] at hD
    cases hq : compileRun regions_c13 σ0_c13 inputs.length plan_c13 with
    | none => rw [hq] at hD; cases hD
    | some q =>
      rw [hq] at hD
      simp only [Option.map_some] at hD
      have h1 : q.1 = D_c13 := Option.some.inj hD
      exact ⟨q.2, by rw [← h1]⟩
  have hE := ArmCertPipe.Physical.agrees_end hA hall
  refine ⟨fin, run, hE.1 _ 4 ?_, ArmCertPipe.Physical.outMem_end hE _ _ ?_⟩
  · have h := outReg_c13
    rw [← hlen, hall] at h
    simp only [Option.map_some] at h
    exact (List.cons.inj (Option.some.inj h)).1
  · have h := outMem_ok_c13
    rw [← hlen, hall] at h
    simp only [Option.map_some] at h
    exact Option.some.inj h

