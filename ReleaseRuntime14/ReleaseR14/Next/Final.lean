/-- A final branch step over ChainInvG: every model step from x lands at the tail's PC (no offset (k+1) needed). -/
theorem finalG_branch (real : Type) [Sail.SailReal real]
    {domain : QueryDomain} (spec : TopologyImageSpec domain)
    (config : AttributeConfig) (rows : List PermissionRow) (mapping : BitVec 64 → Option Nat)
    (m : ArmCert.Premises.TranslationAgreesV1.ConsumerMap)
    (scope : Nat → Prop) (image : MemReloc.Image) (loadBase : MemReloc.Word)
    (separated : ImageTableSeparated scope loadBase mapping (rowsFootprint spec.imageRows).byte)
    (base : BitVec 64) (offset : Nat → BitVec 64) (budget : Nat) (extra : Nat → NativeState → Prop) (k : Nat)
    (room : k < budget) (page : base.toNat % 4096 = 0) (aligned : (offset k).toNat % 4 = 0)
    (w : BitVec 32) (K : Int) (nextOff : BitVec 64)
    (x : NativeState) (inv : ChainInvG spec config rows mapping m scope image loadBase base offset budget extra k x)
    (tail : HeapV2StepCerts.BranchStepV3.BranchTailAt real w K x (base + nextOff))
    (ob : FetchObligations spec config rows mapping w x) :
    ∀ fin, modelStep real x = .ok () fin → fin.regs._PC = base + nextOff := by
  intro fin' h
  have hq : HookQuiet ((budget - (k + 1)) + 1) x := by
    have e : budget - (k + 1) + 1 = budget - k := by omega
    rw [e]; exact inv.v2.v1.quiet
  obtain ⟨fin, run, -, -, -, pc, -⟩ :=
    RtB2.RichG.entry_class_next_v3_brG real spec config rows mapping w K x inv.v2.v1.pins (base + nextOff)
      nextOff tail inv.v2.v1.gic inv.v2.v1.features
      inv.v2.v1.debug (budget - (k + 1)) hq base (offset k) inv.v2.v1.pc page aligned rfl
      inv.v2.v1.current m inv.v2.closed scope image loadBase inv.v2.placed separated inv.v2.branch
      inv.raw inv.noUpd ob.queryOf ob.rawOf ob.vaOf ob.mmio ob.present ob.perAcc ob.code
  rw [run] at h
  cases h
  exact pc

/-- The rich B.cond tail when the condition holds (taken): PC := PC + sext(imm19:00). -/
theorem bcond_tail_taken (real : Type) [Sail.SailReal real] (x : NativeState) (cond : BitVec 4) (imm19 : BitVec 19)
    (noEret : (Sail.BitVec.extractLsb (ArmBridge.CruxGenGuarded.EntryBodyBcond.W cond imm19) 31 12 == 879088#20) = false)
    (dec : Crypto.BcondCore.bcondC cond x.regs ↔ true = true)
    (hlow : (x.regs._PC + sign_extend (imm19 ++ 0#2) 64).toNat < 2 ^ 55)
    (next : BitVec 64) (target : next = x.regs._PC + sign_extend (imm19 ++ 0#2) 64) :
    HeapV2StepCerts.BranchStepV3.BranchTailAt real (ArmBridge.CruxGenGuarded.EntryBodyBcond.W cond imm19) 69 x next := by
  intro fetched enc0 b pins bp input guard quiet it ss
  obtain ⟨sp, a, fin, pmu, run, frame, quiet', pins', sys, brs, mem, _, _, _, _, _, nonProj, _, pcS,
      gpr, spr, gic⟩ :=
    ArmBridge.CruxGenGuarded.EntryBodyBcond.native_tail_x real x fetched enc0 cond imm19 noEret pins bp input guard b quiet it ss
      hlow
  refine ⟨sp, a, fin, pmu, run, frame, quiet', pins', sys, brs, mem, gic, ?_, nonProj, gpr, spr⟩
  rw [pcS, target, if_pos (dec.mpr rfl)]

